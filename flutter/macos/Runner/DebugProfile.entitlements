<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Песочница выключена намеренно: приложению нужны произвольные папки пользователя —
	     та же задача, что на Android решает MANAGE_EXTERNAL_STORAGE. В песочнице доступ
	     к ним даётся только через security-scoped bookmarks, то есть через нативный код. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Ввод с микрофона для голосового ввода в разговоре (см. `record` в pubspec). Приложение
	     без песочницы, поэтому право здесь больше для полноты: оно совпадает с тем, что
	     обещает системный запрос доступа, и не даёт сборке отвалиться на подписи. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
