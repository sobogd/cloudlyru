<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Без этого разрешения release-сборка не может ходить в сеть вовсе. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Обновление по кнопке: открывает системный установщик APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- «Доступ ко всем файлам»: без него не видно ни дерева папок, ни содержимого разделов.
         Приложение личное, поставляется APK-ом, в Google Play не идёт. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <!-- Android 10: разрешения появились в Android 11, поэтому на десятом доступ к пользовательским
         папкам дают обычные разрешения на хранилище — и читать дерево, и писать в него скачанное
         (зеркало кладёт файлы прямо в выбранные папки). Без них `hasAllFilesAccess` отвечал бы
         «доступ есть», а дерево и разделы выглядели бы пустыми без единой подсказки.
         `maxSdkVersion="29"` — на 11 и выше эти разрешения не нужны и не запрашиваются вовсе.
         `tools:replace` обязателен: ту же пару разрешений объявляет `open_filex` (у него
         `maxSdkVersion="32"`), и слияние манифестов падает на расхождении значений —
         проверено сборкой. Наше значение точнее: на 11 и выше доступ даёт
         `MANAGE_EXTERNAL_STORAGE`, а не эти разрешения.
         `requestLegacyExternalStorage` включает на Android 10 прежнюю модель хранилища: без неё
         приложение с targetSdk 30+ видит только свои файлы (на 11 и выше флаг игнорируется). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <!-- Разрешения на постоянный сервис с уведомлением оставлены с прежнего замысла и сейчас
         не используются: постоянного сервиса нет — в манифесте объявлена только служба задания
         `.SyncJobService` (это `JobService`, а не foreground-сервис), `startForeground`
         не вызывается нигде, и уведомления приложение не показывает вовсе. Пока приложение
         выгружено из памяти, работает периодическое задание системы, а не сервис. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Проход зеркала после перезагрузки: система возвращает задание, приложение поднимает
         наблюдение за папками заново. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="Cloudly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        tools:ignore="ScopedStorage">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Периодический проход зеркала, когда приложения нет на экране или его процесс
             выгружен. Пятнадцать минут — минимум JobScheduler, а не расписание: в Doze и при
             экономии батареи система сдвигает запуск (см. SyncJobScheduler). Служба поднимает
             свой движок Flutter, ставит мост к Android (номер файла нужен, чтобы переименование
             не выглядело как повторная выгрузка) и запускает точку входа в Dart (см.
             SyncJobService). Это JobService, а не постоянный сервис: он живёт только на время
             прохода и уведомлений не показывает. -->
        <service
            android:name=".SyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>

        <!-- Задание переживает перезагрузку через setPersisted, но система возвращает такие
             задания только после запуска приложения: получатель заводит его заново, если
             владелец не вышел из аккаунта. -->
        <receiver
            android:name=".SyncBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
