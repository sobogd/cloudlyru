<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Без этого разрешения release-сборка не может ходить в сеть вовсе. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Обновление по кнопке: открывает системный установщик APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- «Доступ ко всем файлам»: без него не видно ни дерева папок, ни содержимого разделов.
         Приложение личное, поставляется APK-ом, в Google Play не идёт. Признак доступа
         приложение проверяет пробой каталога (`NativeFs.hasAllFilesAccess`), а не системным
         вызовом: в Dart `Environment.isExternalStorageManager` нет. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <!-- Android 10: разрешения появились в Android 11, поэтому на десятом доступ к пользовательским
         папкам дают обычные разрешения на хранилище — и читать дерево, и писать в него скачанное
         (зеркало кладёт файлы прямо в выбранные папки). Без них проба доступа отвечала бы
         «доступ есть», а дерево и разделы выглядели бы пустыми без единой подсказки.
         `maxSdkVersion="29"` — на 11 и выше эти разрешения не нужны и не запрашиваются вовсе.
         `tools:replace` обязателен: ту же пару разрешений объявляет `open_filex` (у него
         `maxSdkVersion="32"`), и слияние манифестов падает на расхождении значений —
         проверено сборкой. Наше значение точнее: на 11 и выше доступ даёт
         `MANAGE_EXTERNAL_STORAGE`, а не эти разрешения.
         `requestLegacyExternalStorage` включает на Android 10 прежнюю модель хранилища: без неё
         приложение с targetSdk 30+ видит только свои файлы (на 11 и выше флаг игнорируется). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <!-- Разрешений на постоянный сервис, уведомления и перезагрузку здесь больше нет: своей
         службы у приложения не осталось вовсе. Проход зеркала делает само приложение, пока
         оно запущено (наблюдение за папками и мгновенный режим), а после запуска недостающее
         догоняет `SyncController.checkAndResume`. -->
    <application
        android:label="Cloudly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        tools:ignore="ScopedStorage">
        <!-- Активность объявлена прямо движком Flutter: своей `MainActivity` в проекте нет,
             и весь Kotlin удалён — регистрировать в ней больше нечего (плагины ставит
             `GeneratedPluginRegistrant`, который движок подключает сам). -->
        <activity
            android:name="io.flutter.embedding.android.FlutterActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
