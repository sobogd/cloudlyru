<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- «Доступ ко всем файлам»: без него не видно ни дерева папок, ни содержимого разделов.
         Приложение личное, поставляется APK-ом, в Google Play не идёт (см. ANDROID.md). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Обновление по кнопке: приложение скачивает свою новую сборку и отдаёт её системному
         установщику. Сама установка всё равно подтверждается диалогом системы. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Синхронизация живёт в постоянном сервисе: у телефона нет своего адреса, поэтому
         состояние и команды он забирает сам, пока сервис работает. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Просьба не убивать сервис: на агрессивных прошивках иначе фон не работает. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cloudly">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- «Выбрать файл» из чужого приложения: отвечаем на системный запрос своим экраном,
             без прослойки системного выборщика. Отдаём ссылку на провайдера документов. -->
        <activity
            android:name=".ui.CloudlyPickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cloudly">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.OPENABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Постоянный сервис синхронизации. Тип specialUse, а не dataSync: dataSync
             Android 15 гасит после шести часов в сутки, и «вечного» из него не выйдет. -->
        <service
            android:name=".work.SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="синхронизация файлов пользователя с его собственным сервером" />
        </service>

        <receiver
            android:name=".work.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Облако в системном выборе файлов: «Файлы», диалоги сохранения и «прикрепить файл»
             в других приложениях. Провайдер только читает; права MANAGE_DOCUMENTS у него —
             требование Android к провайдерам документов. -->
        <provider
            android:name=".docs.CloudlyDocumentsProvider"
            android:authorities="ru.cloudly.sync.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:label="@string/app_name"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Скачанный APK уходит системному установщику через content-ссылку: файловые
             пути (file://) начиная с Android 7 установщику не отдаются вовсе. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ru.cloudly.sync.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
