<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- «Доступ ко всем файлам»: без него не видно ни дерева папок, ни содержимого разделов.
         Приложение личное, поставляется APK-ом, в Google Play не идёт (см. ANDROID.md). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Обновление по кнопке: приложение скачивает свою новую сборку и отдаёт её системному
         установщику. Сама установка всё равно подтверждается диалогом системы. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Периодическое задание зеркала переживает перезагрузку (JobScheduler setPersisted):
         без этого разрешения задание пришлось бы заводить заново после каждого включения. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cloudly">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Зеркало выбранных папок «Файлы»: проход запускает система по расписанию и по
             событию файловой системы. Отдельного foreground-сервиса нет — запуск уведомления
             из фона на Android 12+ ограничен, а проход укладывается в лимит задания. -->
        <service
            android:name=".mirror.MirrorJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- «Выбрать файл» из чужого приложения: отвечаем на системный запрос своим экраном,
             без прослойки системного выборщика. Отдаём ссылку на провайдера документов. -->
        <activity
            android:name=".ui.CloudlyPickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cloudly">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.OPENABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Облако в системном выборе файлов: «Файлы», диалоги сохранения и «прикрепить файл»
             в других приложениях. Провайдер только читает; права MANAGE_DOCUMENTS у него —
             требование Android к провайдерам документов. -->
        <provider
            android:name=".docs.CloudlyDocumentsProvider"
            android:authorities="ru.cloudly.sync.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:label="@string/app_name"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Скачанный APK уходит системному установщику через content-ссылку: файловые
             пути (file://) начиная с Android 7 установщику не отдаются вовсе. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ru.cloudly.sync.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
