// CloudlyRu — Prisma-схема (PostgreSQL).
// M0: пользователь/сессии, файловое дерево (soft delete), Asset = объект в S3 (дедуп по sha256).

generator client {
  provider      = "prisma-client-js"
  // прод-сервер — ARM64 (Hetzner aarch64, Ubuntu 22.04, OpenSSL 3); раннер GitHub — x64
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Пользователи, сессии, токены =====

model User {
  id            String     @id @default(uuid())
  login         String     @unique
  passwordHash  String
  createdAt     DateTime   @default(now())
  sessions      Session[]
  apiTokens     ApiToken[]
  shares        Share[]
  rootFolderId  String? // корневая папка пользователя (создаётся при seed)
  photoFolderId String? // системная папка «Фото» (медиа-зона; создаётся при seed/lazy)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique // sha256 токена; сам токен живёт только в cookie
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  label      String
  tokenHash  String    @unique
  scope      String    @default("files:rw") // files:rw | files:ro (проверяется в resolveApiToken)
  expiresAt  DateTime? // null = бессрочный (легаси-токены)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== Файловое дерево =====
// parentId всегда не-null: верхний уровень = дети корневой папки (root).
// Удаление — soft (deletedAt), hard delete только через purge (корзина, retention).

model Folder {
  id        String      @id @default(uuid())
  parentId  String? // null = верхний уровень (корень пользователя)
  name      String
  // зона: FILES (обычный диск, медиа хранится как есть) | PHOTOS (поддерево системной папки «Фото», медиа конвертируется)
  zone      String      @default("FILES")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  parent    Folder?     @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]    @relation("FolderTree")
  entries   FileEntry[]

  // Postgres: NULL-ы в unique-индексе не конфликтуют — дубли на верхнем уровне ловим в сервисе
  @@unique([parentId, name])
  @@index([parentId, deletedAt])
}

model FileEntry {
  id         String      @id @default(uuid())
  folderId   String
  assetId    String
  name       String
  // зона папки на момент создания (FILES|PHOTOS) — для фильтра таймлайна и политики конвертации
  zone       String      @default("FILES")
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  folder     Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  albumItems AlbumItem[]

  @@unique([folderId, name])
  @@index([folderId, deletedAt])
  @@index([zone, deletedAt])
}

// Физический объект в S3 (один на уникальное содержимое)
model Asset {
  id            String      @id @default(uuid())
  sha256        String      @unique
  size          BigInt
  mime          String
  ext           String?
  createdAt     DateTime    @default(now())
  masterReadyAt DateTime?
  masterMime    String?
  entries       FileEntry[]
  media         MediaMeta?
  jobs          Job[]
}

// Активная загрузка файла: multipart-сессия в S3. Принятые части (partNumber + ETag)
// лежат в БД, а не в RAM: рестарт сервиса больше не теряет сессию, а complete может
// собрать объект по ETag'ам, пришедшим с клиента (прямая загрузка в S3).
model UploadSession {
  id         String   @id @default(uuid())
  userId     String
  s3UploadId String   @unique
  uploadKey  String // временный ключ объекта в S3 (files/tmp/<token>) для abort/cleanup
  folderId   String?
  name       String
  size       BigInt
  mime       String
  partCount  Int      @default(0) // сколько частей принято
  parts      Json? // [{ partNumber, etag, size }] — принятые части multipart
  // sha256, объявленный клиентом (браузер считает инкрементально до загрузки):
  // нужен для дедупа до передачи байтов и как ожидаемое значение при верификации.
  declaredSha256 String?
  direct     Boolean  @default(false) // части льются клиентом прямо в S3 (без релея через сервер)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

// ===== Шаринг (каркас M1) =====

enum ShareKind {
  FOLDER
  FILE
  ALBUM
}

enum ShareCapability {
  VIEW
  DOWNLOAD
  UPLOAD
  RW
}

model Share {
  id           String          @id @default(uuid())
  // владелец ссылки: без него list/update/revoke работали по одному токену,
  // то есть любой залогиненный мог увидеть и отозвать чужой шаринг
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ShareKind
  targetId     String
  token        String          @unique // 128 бит случайности
  passwordHash String?
  capability   ShareCapability @default(VIEW)
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

// ===== Аудит =====

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===== M2: медиа-метаданные (EXIF), альбомы =====

model MediaMeta {
  id         String    @id @default(uuid())
  assetId    String    @unique
  capturedAt DateTime?
  latitude   Float?
  longitude  Float?
  make       String?
  model      String?
  width      Int?
  height     Int?
  /// Полный набор извлечённых тегов (EXIF для фото / ffprobe для видео) — для деталки файла
  raw        Json?
  createdAt  DateTime  @default(now())
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Album {
  id        String      @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime    @default(now())
  items     AlbumItem[]

  @@index([userId])
}

model AlbumItem {
  id        String    @id @default(uuid())
  albumId   String
  entryId   String
  createdAt DateTime  @default(now())
  album     Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  entry     FileEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([albumId, entryId])
}

// ===== M2.5: очередь конвертации (оригинал -> AVIF/AV1 + производные) =====

model Job {
  id         String    @id @default(uuid())
  assetId    String
  kind       String // 'photo' | 'video'
  state      String    @default("pending") // pending|processing|done|failed
  error      String?
  attempts   Int       @default(0)
  progress   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([assetId])
}

// ===== Разархивирование архивов внутри хранилища (без диска) =====
// ZIP читается из S3 по Range-запросам, файлы кладутся обратно в S3
// (content-addressed, с дедупом), в дерево добавляется папка с именем архива.

model UnzipJob {
  id             String    @id @default(uuid())
  entryId        String // FileEntry архива (.zip)
  assetId        String
  folderId       String // папка архива (родитель будущей папки с содержимым)
  targetFolderId String? // созданная папка-приёмник
  state          String    @default("pending") // pending|processing|done|failed|cancelled
  totalEntries   Int       @default(0)
  doneEntries    Int       @default(0)
  totalBytes     BigInt    @default(0)
  doneBytes      BigInt    @default(0)
  skippedEntries Int       @default(0) // уже существовали (идемпотентный перезапуск)
  cursorIndex    Int       @default(0) // чекпойнт: сколько файлов архива уже обработано
  currentName    String?
  error          String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([state, createdAt])
  @@index([entryId])
}
