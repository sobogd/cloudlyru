// CloudlyRu — Prisma-схема (PostgreSQL).
// Пользователь, сессии и device-токены, файловое дерево (soft delete, корзина), Asset = объект
// в S3 (дедуп по sha256), сессии multipart-загрузок, журнал изменений для синхронизации клиентов,
// очередь конвертации медиа (плюс её статистика, состояние и распаковка архивов), альбомы и EXIF,
// аудит, почта (аккаунты, курсоры синка, письма, вложения, логотипы отправителей).

generator client {
  provider      = "prisma-client-js"
  // прод-сервер — ARM64 (Hetzner aarch64, Ubuntu 22.04, OpenSSL 3); раннер GitHub — x64
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Пользователи, сессии, токены =====

model User {
  id            String     @id @default(uuid())
  login         String     @unique
  passwordHash  String
  createdAt     DateTime   @default(now())
  sessions      Session[]
  apiTokens     ApiToken[]
  mailAccounts  MailAccount[]
  rootFolderId  String? // корневая папка пользователя (создаётся при seed)
  photoFolderId String? // системная папка «Фото» (медиа-зона; создаётся при seed/lazy)
  phoneFolderId String? // системная папка «Телефон» (зеркало папок телефона; создаётся lazy)
  // системная папка «Почта» (зона MAIL): вложения писем. Создаётся лениво при первом
  // обращении почтового модуля и скрыта отовсюду, поэтому в `GET /auth/me` не отдаётся.
  mailFolderId  String?
  // Буфер копирования/вырезания. В БД, а не в localStorage браузера: буфер должен быть
  // один на аккаунт — скопировал на телефоне, вставил на ноутбуке. Одна цель за раз.
  clipboardKind String? // 'file' | 'folder'
  clipboardId   String?
  clipboardMode String? // 'copy' | 'cut'
  clipboardAt   DateTime?
  aiChats       AiChat[]
  aiSettings    AiSettings?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique // sha256 токена; сам токен живёт только в cookie
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Кто вошёл и откуда: без этого список сеансов в приложении был бы списком из неразличимых
  // строк («сеанс, созданный 17 сентября»), и человек не понимал бы, какой из них его телефон,
  // а какой — чужой браузер. Пусто у сессий, созданных до этой правки.
  client    String? // как клиент себя назвал (обычно приложение и его версия)
  ip        String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Протухшие сессии подчищает таймер AuthService (и кап при логине) — по expiresAt,
  // поэтому индекс именно тут: без него уборка идёт сканом всей таблицы сессий.
  @@index([expiresAt])
}

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  label      String
  tokenHash  String    @unique
  scope      String    @default("files:rw") // files:rw | files:ro (проверяется в resolveApiToken)
  // Колонка добавлена позже (миграция 0010), когда токены уже были выпущены и жили бессрочно:
  // проставить им срок задним числом значило бы выдумать дату, поэтому поле nullable, а NULL
  // честно читается как «бессрочный» — так и живут токены, выпущенные до появления TTL.
  expiresAt  DateTime? // null = бессрочный (легаси-токены)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  // корень зеркала этого устройства («<Имя> - Файлы»); создаётся лениво
  mirrorFolderId String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== Файловое дерево =====
// parentId всегда не-null: верхний уровень = дети корневой папки (root).
// Удаление — soft (deletedAt), hard delete только через purge (корзина, retention).

model Folder {
  id        String      @id @default(uuid())
  parentId  String? // null = верхний уровень (корень пользователя)
  name      String
  // зона: FILES (обычный диск, медиа хранится как есть) | PHOTOS (поддерево системной папки «Фото», медиа конвертируется)
  zone      String      @default("FILES")
  // легаси: флаг «держать офлайн» снят с поддержки. Колонка оставлена, чтобы не делать
  // миграцию по данным; код её больше не читает и не пишет.
  keepOffline Boolean   @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  // Физическое удаление (purge корзины) уносит только саму строку: FK на родителя объявлен
  // ON DELETE SET NULL (миграция 0001_init), поэтому у пережившего ребёнка parentId становится
  // NULL и поддерево выпадает из дерева пользователя. RESTRICT тут не годится: purge удаляет
  // папки одним deleteMany по списку id, порядок строк внутри него не определён, и запрет
  // удалять родителя с живым ребёнком валил бы всю транзакцию чистки.
  parent    Folder?     @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]    @relation("FolderTree")
  entries   FileEntry[]

  // Postgres: NULL-ы в unique-индексе не конфликтуют — дубли на верхнем уровне ловим в сервисе
  @@unique([parentId, name])
  @@index([parentId, deletedAt])
}

model FileEntry {
  id         String      @id @default(uuid())
  folderId   String
  assetId    String
  name       String
  // зона папки на момент создания (FILES|PHOTOS) — для фильтра таймлайна и политики конвертации
  zone       String      @default("FILES")
  // mtime файла на устройстве-источнике: без него синхронизация сравнивала бы даты,
  // которые сервер не знает, и каждый скан считал бы скачанный файл «изменённым»
  clientMtime DateTime?
  // легаси-поле файла: флаг «держать офлайн» снят с поддержки, код его не использует
  keepOffline Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  folder     Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  albumItems AlbumItem[]
  // обратная сторона MailAttachment.entryId: вложение письма — обычная запись дерева
  // (в скрытой зоне MAIL), поэтому её содержимое дедуплицируется с файлами пользователя
  mailAttachment MailAttachment?

  @@unique([folderId, name])
  @@index([folderId, deletedAt])
  @@index([zone, deletedAt])
  // Проверка «это мой файл» (ownsAsset) и соединение в ленте идут по assetId. Парный индекс
  // с порядком NULLS LAST по MediaMeta.capturedAt живёт в миграции: в схеме он не выражается.
  @@index([assetId, deletedAt])
}

// Физический объект в S3 (один на уникальное содержимое)
model Asset {
  id            String      @id @default(uuid())
  sha256        String      @unique
  size          BigInt
  mime          String
  ext           String?
  createdAt     DateTime    @default(now())
  // Состояние превью: 'none' — ещё нет (задача ждёт, упала или её ещё не ставили),
  // 'done' — собраны, 'impossible' — собрать нельзя (причина в previewError).
  // Превью строятся из содержимого, поэтому состояние живёт на ассете, а не на записи в дереве.
  previewState  String      @default("none")
  previewError  String?
  // Число страниц PDF: по нему перечисляются превью страниц при удалении файла.
  pageCount     Int?
  entries       FileEntry[]
  media         MediaMeta?
  jobs          Job[]
  // сырые .eml писем: объект в S3 тот же content-addressed files/<sha256>, а строка Asset
  // нужна, чтобы объект был на учёте (иначе его снесёт deploy/scripts/sweep-orphans.mjs)
  mailRaw       MailMessage[] @relation("MailRawAsset")

  @@index([previewState])
}

// Активная загрузка файла: multipart-сессия в S3. Принятые части (partNumber + ETag)
// лежат в БД, а не в RAM: рестарт сервиса больше не теряет сессию, а complete может
// собрать объект по ETag'ам, пришедшим с клиента (прямая загрузка в S3).
model UploadSession {
  id         String   @id @default(uuid())
  userId     String
  s3UploadId String   @unique
  uploadKey  String // временный ключ объекта в S3 (files/tmp/<token>) для abort/cleanup
  folderId   String?
  name       String
  size       BigInt
  mime       String
  partCount  Int      @default(0) // сколько частей принято
  parts      Json? // [{ partNumber, etag, size }] — принятые части multipart
  // sha256, объявленный клиентом (браузер считает инкрементально до загрузки):
  // нужен для дедупа до передачи байтов и как ожидаемое значение при верификации.
  declaredSha256 String?
  direct     Boolean  @default(false) // части льются клиентом прямо в S3 (без релея через сервер)
  // Перезапись существующего файла с тем же именем: без неё зеркалирование на каждом
  // изменённом файле получало бы 409, а «удали + создай» меняло бы id записи у всех устройств
  replace    Boolean  @default(false)
  // Имя занято записью из корзины, и клиент синхронизации разрешил её занять
  // (replaceTrashed в init): запись восстанавливается и перезаписывается. Без флага
  // поведение прежнее — 409 in_trash, и файл с таким именем не уезжает в облако никогда.
  replaceTrashed Boolean @default(false)
  // mtime файла на устройстве-источнике, чтобы он попал в FileEntry при создании записи
  clientMtime DateTime?
  // Предполётное условие перезаписи (оптимистичная блокировка): клиент говорит, какую
  // версию файла он заменяет. Если на сервере уже другая — 409 со снимком текущей версии,
  // и клиент сохраняет свою копию как конфликтную, а не затирает чужую правку.
  expectedSha256    String?
  expectedUpdatedAt DateTime?
  // Сессия не удаляется сразу после complete: ретрай после потерянного ответа должен
  // получить тот же результат, а не 404 (клиент на плохой сети иначе считает загрузку провалом)
  completedAt DateTime?
  result      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

// ===== Аудит =====

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===== M2: медиа-метаданные (EXIF), альбомы =====

model MediaMeta {
  id         String    @id @default(uuid())
  assetId    String    @unique
  capturedAt DateTime?
  latitude   Float?
  longitude  Float?
  make       String?
  model      String?
  width      Int?
  height     Int?
  /// Полный набор извлечённых тегов (EXIF для фото / ffprobe для видео) — для деталки файла
  raw        Json?
  createdAt  DateTime  @default(now())
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Album {
  id        String      @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime    @default(now())
  items     AlbumItem[]

  @@index([userId])
}

model AlbumItem {
  id        String    @id @default(uuid())
  albumId   String
  entryId   String
  createdAt DateTime  @default(now())
  album     Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  entry     FileEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([albumId, entryId])
}

// ===== Журнал изменений дерева для клиентов синхронизации (M3) =====
// Append-only лента: клиент держит курсор по seq и применяет изменения по порядку.
// Записи НЕ связаны внешними ключами с FileEntry/Folder — смысл журнала в том, что
// tombstone переживает физическое удаление строки (trash purge), иначе клиент зальёт
// удалённый файл заново. Поля — снимок состояния цели на момент события, поэтому клиенту
// достаточно применить строку, а не восстанавливать состояние запросами.

model ChangeLog {
  seq         BigInt   @id @default(autoincrement())
  userId      String
  target      String // entry | folder
  op          String // create | update | move | delete | restore
  targetId    String // id FileEntry или Folder (у tombstone — уже не существующий)
  folderId    String? // родительская папка цели на момент события
  name        String
  zone        String?
  sha256      String?
  size        BigInt?
  mime        String?
  clientMtime DateTime?
  // легаси: снимок флага «держать офлайн» в событии журнала; новые события его не пишут
  keepOffline Boolean  @default(false)
  // id ApiToken устройства, если изменение пришло от клиента синхронизации (иначе null)
  deviceId    String?
  at          DateTime @default(now())

  @@index([userId, seq])
  @@index([at])
}

// ===== Очередь конвертации (оригинал → превью) =====
// Строка = одна задача на ассет: создаётся сигналом (загрузка в «Фото», пересчёт), живёт до
// успеха (тогда удаляется) или до ошибки (остаётся, чтобы её можно было повторить).

model Job {
  id         String    @id @default(uuid())
  assetId    String
  kind       String // 'photo' | 'video' | 'pdf'
  state      String    @default("pending") // pending | processing | failed
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([assetId])
}

// ===== Пауза конвертации =====
// Одна строка (id = 1). В БД, а не в памяти воркера: пауза должна пережить рестарт
// и действовать для всех процессов сразу.

model QueueState {
  id        Int      @id @default(1)
  paused    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ===== Статистика конвертации =====
// Длительность сборки превью по видам задач. Нужна потому, что строка Job на успехе
// удаляется (очередь — это список того, что осталось), а без средней длительности
// остаток «7399 видео» не переводится в срок. Читается в /queue/status, старые строки
// подчищаются самим воркером (30 дней).

model ConvertStat {
  id         String   @id @default(uuid())
  kind       String // 'photo' | 'video' | 'pdf'
  state      String   @default("done") // done | failed
  durationMs Int
  finishedAt DateTime @default(now())

  @@index([kind, finishedAt])
}

// ===== Разархивирование архивов внутри хранилища (без диска) =====
// ZIP читается из S3 по Range-запросам, файлы кладутся обратно в S3
// (content-addressed, с дедупом), в дерево добавляется папка с именем архива.

model UnzipJob {
  id             String    @id @default(uuid())
  entryId        String // FileEntry архива (.zip)
  assetId        String
  folderId       String // папка архива (родитель будущей папки с содержимым)
  targetFolderId String? // созданная папка-приёмник
  state          String    @default("pending") // pending|processing|done|failed|cancelled
  totalEntries   Int       @default(0)
  doneEntries    Int       @default(0)
  totalBytes     BigInt    @default(0)
  doneBytes      BigInt    @default(0)
  skippedEntries Int       @default(0) // уже существовали (идемпотентный перезапуск)
  cursorIndex    Int       @default(0) // чекпойнт: сколько файлов архива уже обработано
  currentName    String?
  error          String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([state, createdAt])
  @@index([entryId])
}

// ===== Почта: аккаунты, курсоры синка, письма и вложения =====
// Модель «две папки»: всё полученное (включая спам) — inbox, всё отправленное — sent.
// Папок, меток и фильтров у почты нет намеренно, поэтому папок источника много,
// а корзин у нас ровно две (см. MailCursor.box).

model MailAccount {
  id          String    @id @default(uuid())
  userId      String
  kind        String // 'gmail' | 'icloud' | 'imap' — от него зависят имена папок источника
  email       String // адрес, которым подписываются письма и по которому идёт дедуп
  imapHost    String
  imapPort    Int       @default(993)
  smtpHost    String
  smtpPort    Int       @default(465)
  login       String // логин IMAP/SMTP (у Gmail и iCloud совпадает с email, но это не гарантия)
  // app password, зашифрованный AES-256-GCM ключом MAIL_SECRET_KEY: это ключ ко всей
  // переписке, в открытом виде он не хранится и в логи не попадает.
  secretEnc   String
  // Отправка может идти через другой сервис, чем приём (у Brevo логин и ключ свои,
  // а не пароль ящика). Пусто — берём login/secretEnc: так живут Gmail и iCloud.
  smtpLogin      String?
  smtpSecretEnc  String?
  authKind    String    @default("password") // password | oauth2 (задел под Gmail API)
  enabled     Boolean   @default(true)
  status      String    @default("idle") // idle | syncing | error
  statusError String?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cursors     MailCursor[]
  messages    MailMessage[]
  failures    MailIngestFailure[]

  @@unique([userId, email])
  @@index([userId])
}

// Курсор синхронизации по одной папке источника: пар (uidValidity, lastUid) достаточно для
// инкремента, а `box` говорит, в какую из наших двух папок раскладывать письма отсюда.
model MailCursor {
  id           String      @id @default(uuid())
  accountId    String
  imapPath     String // 'INBOX', '[Gmail]/All Mail', 'Sent Messages', …
  box          String // 'inbox' | 'sent'
  uidValidity  BigInt // сменилась — папка пересинкивается целиком
  lastUid      BigInt      @default(0)
  // Бэкфилл идёт от свежих к старым (сначала 90 дней, глубина фоном), поэтому докуда
  // дошли вглубь — это дата, а не uid.
  backfillFrom DateTime?
  backfillDone Boolean     @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  account      MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, imapPath])
  @@index([accountId])
}

/// Письмо, которое не удалось сохранить в облако.
///
/// Зачем таблица, а не память процесса: после INGEST_MAX_TRIES попыток письмо пропускают,
/// то есть курсор уходит дальше и письмо больше не попадётся. Единственным следом остаётся
/// строка в логе и счётчик в `MailAccount.statusError` — но счётчик, живущий в памяти,
/// стирается первым перезапуском, и дырка в архиве становится невидимой навсегда.
///
/// Строка живёт до тех пор, пока письмо не сохранится (`MailSyncService.clearUnsaved`):
/// сохранённое письмо удаляет запись по тем же координатам.
model MailIngestFailure {
  id          String   @id @default(uuid())
  accountId   String
  folderPath  String // папка источника на сервере
  uidValidity BigInt // без неё uid не уникален: провайдер перенумеровывает папку
  uid         BigInt
  /// Сколько раз пробовали сохранить. По этому числу видно, письмо ещё пробуют или уже нет.
  tries       Int      @default(1)
  /// Причина последней неудачи: та же строка, что уходит в лог (обрезана до 200 знаков).
  error       String
  /// Когда письмо впервые не сохранилось и когда пытались в последний раз.
  firstAt     DateTime @default(now())
  lastAt      DateTime @updatedAt
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Координаты письма: по ним запись обновляется и снимается.
  @@unique([accountId, folderPath, uidValidity, uid])
  @@index([accountId, lastAt(sort: Desc)])
}

model MailMessage {
  id             String    @id @default(uuid())
  userId         String
  accountId      String
  box            String // основная папка: 'inbox' | 'sent'
  // Папки сверх основной. Одно и то же письмо бывает сразу в двух: отправленное себе
  // (наша копия в «Исходящих» плюс пришедшая обратно) и две копии на сервере у iCloud
  // (INBOX и Sent Messages). Строка при этом одна — иначе задваивались бы вложения и файл .eml.
  alsoBoxes      String[] @default([])
  folderPath     String // папка источника: по ней и курсору письмо находится повторно
  uid            BigInt
  uidValidity    BigInt
  // X-GM-MSGID — стабильный идентификатор письма у Gmail: он не меняется при переносе
  // между папками, поэтому дедуп для Gmail идёт по нему, а не по uid.
  gmailMsgId     String?
  messageId      String? // Message-ID из заголовков
  threadKey      String? // X-GM-THRID либо нормализованная тема для iCloud
  subject        String?
  fromName       String?
  fromAddr       String?
  toAddrs        String[]
  ccAddrs        String[]
  replyTo        String?
  inReplyTo      String?
  refs           String[] // References из заголовков — для сборки треда
  sentAt         DateTime? // Date из заголовков (может врать и отсутствовать)
  receivedAt     DateTime // INTERNALDATE — время прихода на сервер, ему и верим
  // Ключ сортировки ленты: receivedAt для входящих, sentAt (иначе receivedAt) для исходящих.
  // Отдельной колонкой, чтобы индекс ленты не зависел от выражения COALESCE.
  sortAt         DateTime
  size           Int
  hasAttachments Boolean   @default(false)
  seen           Boolean   @default(false)
  flagged        Boolean   @default(false)
  // Первые ~2 КБ текста: превью в списке рисуется без разбора .eml из S3.
  bodyText       String?
  // Текст под полнотекстовый поиск: тема, участники и ПОЛНОЕ тело письма одной строкой
  // (потолок — SEARCH_TEXT_MAX_CHARS в mail-parse.ts). Отдельная колонка нужна потому, что
  // `bodyText` — только превью первых 2 КБ, а искать надо по всему телу; разбирать .eml
  // из S3 на каждый поисковый запрос нечем. Индекс по этой колонке объявлен в миграции
  // 20260917140000_mail_search_text: он выражение (GIN по tsvector), а выражение в схеме
  // не записывается.
  searchText     String?
  // Когда письмо попало в поисковый индекс. NULL — ещё нет: письма, сохранённые до появления
  // поиска, добирает фоновый проход (src/mail/mail-index.service.ts), а отметка не даёт ему
  // вечно возвращаться к письмам, которые не разбираются.
  searchIndexedAt DateTime?
  rawAssetId     String // Asset сырого .eml (объект files/<sha256>)
  // Удаление письма из веб-морды — soft (корзина общая с файлами); `remoteDeletedAt` — уже
  // про источник, когда копию убрали с сервера аккаунта.
  deletedAt       DateTime?
  remoteDeletedAt DateTime?
  // Сколько раз пытались убрать копию с сервера и чем кончилось. Нужно для разбора: без этих
  // полей «письмо почему-то не удаляется» выяснять неоткуда, а молчаливые повторы бесконечны.
  remotePurgeTries Int       @default(0)
  remotePurgeError String?
  createdAt      DateTime  @default(now())
  account        MailAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rawAsset       Asset           @relation("MailRawAsset", fields: [rawAssetId], references: [id], onDelete: Restrict)
  attachments    MailAttachment[]

  // Идемпотентность повторного прохода по папке: то же письмо не заводится второй раз.
  @@unique([accountId, folderPath, uidValidity, uid])
  // Лента: свежие сверху; порядок совпадает с индексом (NULL в sortAt не бывает).
  @@index([userId, box, sortAt(sort: Desc), id(sort: Desc)])
  // Индекса по (accountId, gmailMsgId) здесь нет намеренно: в миграции он объявлен
  // УНИКАЛЬНЫМ и частичным (WHERE gmailMsgId IS NOT NULL) — так дедуп защищён на уровне БД,
  // а в схеме частичный уникальный индекс не выражается.
  @@index([accountId, messageId])
  // Корзина ленты: порядок по deletedAt при фильтре по пользователю. Индекс ленты сортирует
  // по sortAt и в этом запросе не помогает, а `deletedAt` в одиночку не селективен.
  @@index([userId, deletedAt])
  @@index([deletedAt])
  // Письмо бывает сразу в двух папках (см. alsoBoxes), и лента ищет его условием
  // `box = X OR X = ANY(alsoBoxes)`: индекс ленты покрывает только первую половину, а по массиву
  // Postgres без GIN идёт перебором строк. Массив маленький (обычно 0–1 элемент), поэтому
  // индекс дешёвый и по размеру, и по записи.
  @@index([alsoBoxes], type: Gin)
  // Индекс под догоняющую чистку (accountId + createdAt, только письма с живой копией
  // у провайдера) тоже объявлен в миграции: он частичный (WHERE "remoteDeletedAt" IS NULL),
  // а частичный индекс в схеме не выражается. См. 20260916000100_mail_purge_index.
}

// Вложение письма = обычная запись дерева в скрытой зоне MAIL плюс связь с письмом.
// Через `entryId` файл открывается деталкой (превью, размер, скачивание), через
// `messageId` — обратный переход «файл → письмо».
model MailAttachment {
  id        String   @id @default(uuid())
  messageId String
  entryId   String   @unique
  // Порядковый номер части в разобранном письме. Путь MIME ('1.2') тут не годится: разбор
  // идёт через mailparser, который пути не отдаёт, а саму часть мы сохраняем в S3 — искать
  // её повторно в .eml не нужно.
  partIndex Int
  filename  String // исходное имя из письма (запись дерева носит имя с приставкой даты)
  mime      String
  size      Int
  contentId String? // Content-ID инлайн-картинки: по нему подменяется cid: в HTML письма
  inline    Boolean  @default(false)
  createdAt DateTime @default(now())
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  entry     FileEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([messageId, partIndex])
  @@index([messageId])
}

// Логотип отправителя: favicon домена, вытащенный сервером и закэшированный в БД.
// Фетч — только с сервера (клиент наружу не ходит), поэтому логотипы приватны, а не
// трекинг через сторонний сервис. bytes = null — у домена favicon нет (или не картинка);
// triedAt хранит последнюю попытку, чтобы не дёргать один и тот же домен на каждое письмо.
model SenderFavicon {
  domain    String   @id
  bytes     Bytes? // favicon; null — не нашёлся
  mime      String?
  triedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== Фактуры (перенесено из отдельного сервиса iq-factura) =====
//
// Это тот же набор таблиц, что жил в базе `iq_factura`, с теми же именами в БД (`users`,
// `companies`, `invoices`, …): данные переносятся пылесосом, без переименований и трансформаций.
// Меняются только имена ДВУХ моделей Prisma — `User` → `FacturaUser` и `Session` →
// `FacturaSession`: имена моделей глобальны внутри одной схемы, а в облаке уже есть свои `User`
// и `Session`. Физические имена заданы через `@@map` и остаются прежними.
//
// Что здесь мёртвое после переноса (оставлено намеренно, чтобы не потерять данные):
//  - `FacturaUser.otp/otpExpiresAt/otpAttempts/sessionToken` — остатки прежнего входа по коду
//    из письма; вход теперь общий с облаком;
//  - `FacturaSession` — прежние сессии фактуры, в том числе 36 строк истории;
//  - `UserCompany`/`Role` — привязка человек↔компания: компания теперь одна и задана
//    конфигом (`FACTURA_COMPANY_ID`), а таблица остаётся как след происхождения данных.
//
// `Onboarding*`-поля и `pendingCompanyName/pendingTaxId` — тоже наследие регистрации на лендинге.

model FacturaUser {
  id              String    @id @default(cuid())
  email           String    @unique
  otp             String?
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)
  sessionToken    String?
  preferredLocale String?
  // Captured on signup before OTP verify, consumed when creating the first Company.
  pendingCompanyName String?
  pendingTaxId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  companies       UserCompany[]
  sessions        FacturaSession[]
  supportMessages SupportMessage[]

  @@map("users")
}

model FacturaSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user      FacturaUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  user    FacturaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("users_companies")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Company {
  id        String   @id @default(cuid())
  name      String

  // --- Emitter profile (drives PDF "Sent by" block) ---
  legalName     String?  // "Bogdan Sokolov" — falls back to name
  taxId         String?  // NIF / CIF / VAT (e.g. "Z1894474S")
  vatId         String?  // VAT identifier when different from taxId (e.g. "ESZ1894474S")
  addressLine1  String?
  addressLine2  String?
  city          String?
  postalCode    String?
  region        String?
  country       String?  // ISO 3166-1 alpha-2 (e.g. "ES")
  // Banking
  bankName      String?
  iban          String?
  swift         String?
  // Manual IRPF override. When set, this rate wins over the auto-
  // computation from activityType + activityStartDate. Use when a
  // gestor told the user a specific rate that doesn't match the
  // default rules.
  defaultIrpfRate Decimal? @db.Decimal(5, 2)
  // Tax profile — drives the auto IRPF computation:
  //   "profesional"          → 7% in alta year + 2 following, then 15
  //   "empresarial"          → 0% (estimación directa, no retention)
  //   "modulos_empresarial"  → 1%
  //   "modulos_agricola"     → 2%
  //   "alquiler"             → 15% (urban rental retention)
  // Null = treat as "profesional" for backwards compat with existing rows.
  activityType      String?
  /// Date the autónomo was registered. Used together with activityType
  /// to pick the 7% reduced rate during the first 3 calendar years.
  /// Stored as @db.Date so timezone doesn't shift the year boundary.
  activityStartDate DateTime? @db.Date
  // Where to start invoice numbering within the current year. Useful when
  // migrating from another tool mid-year.
  invoiceNumberOffset Int  @default(0)
  /// ISO 4217 default invoice currency for this account. Picked in the
  /// account-settings currency selector. Used as the fallback when a
  /// Contact has no explicit currency. VeriFactu still receives EUR
  /// regardless — see Invoice.*Eur fields.
  baseCurrency String @default("EUR")

  // --- Onboarding ---
  onboardingStep Int @default(0) // 0=not started, 1=basic, 2=complete

  // --- Verifactu signing certificate (per-tenant) ---
  // PKCS#12 unwrapped to a PEM blob (private key + signer cert + chain)
  // and re-encrypted with AES-256-GCM using VERIFACTU_MASTER_KEY from
  // the service .env. The original .p12 password is discarded at upload
  // time — the master key alone is enough to recover the signing
  // material at submit time. Losing the master key means every tenant
  // must re-upload; that's the deliberate trade-off vs storing the
  // user-typed password.
  verifactuCertCipher  Bytes?
  verifactuCertNonce   Bytes?   // 12-byte AES-GCM nonce, unique per cert
  verifactuCertTag     Bytes?   // 16-byte AES-GCM auth tag
  /// NIF read out of the cert at upload time; validated to match
  /// Company.taxId. Stored explicitly so the dashboard can show
  /// "Cert loaded — NIF X" without needing to decrypt.
  verifactuCertNif     String?
  /// notAfter from the X.509 cert. Used by the dashboard to warn
  /// the user before expiry and by the submit flow to refuse a
  /// submission when expired.
  verifactuCertExpiry  DateTime?
  /// Subject + issuer DNs in human-readable form for the UI status
  /// pill (so the user can see "FNMT-RCM / AC FNMT Usuarios" at a
  /// glance and know they uploaded the right cert).
  verifactuCertSubject String?
  verifactuCertIssuer  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             UserCompany[]
  contacts          Contact[]
  invoices          Invoice[]
  supportMessages   SupportMessage[]
  bankAccounts      BankAccount[]
  expenses          Expense[]
  filedDeclarations FiledDeclaration[]

  @@map("companies")
}

/// Per-company bank accounts. A company can keep multiple accounts (e.g.
/// "Wise EUR" for EU clients, "Stripe USD" for US clients, "BBVA local"
/// for cash flows in Spain) and pick which one prints in the invoice's
/// "Payment details" block. The legacy single-account fields on Company
/// (bankName / iban / swift) stay as a fallback for existing invoices —
/// new flows should use this table.
model BankAccount {
  id         String    @id @default(cuid())
  companyId  String
  /// Free-form nickname shown in the dashboard list ("Wise EUR",
  /// "BBVA local", …). When empty the UI falls back to the bank
  /// name + last 4 of the IBAN.
  label      String?
  bankName   String?
  iban       String?
  swift      String?
  /// ISO 4217 currency code (e.g. "EUR", "USD"). Optional — invoices
  /// default to EUR today, this lets the dashboard surface multi-
  /// currency setups later without another migration.
  currency   String?
  /// The account the invoice form pre-selects when the user hasn't
  /// picked one yet. At most one default per company; the UI enforces
  /// uniqueness, the DB column itself is permissive.
  isDefault  Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([companyId])
  @@index([companyId, archivedAt])
  @@map("bank_accounts")
}

/// Counterparty (client) the company invoices. Address lines are stored as
/// a flat array (Json) so the dashboard form can mirror the legacy PDF
/// "up to N lines" layout without a rigid address schema.
model Contact {
  id          String   @id @default(cuid())
  companyId   String
  name        String   // display name in lists
  taxId       String?  // VAT / NIF / Reg. no
  countryCode String?  // ISO alpha-2
  isEu        Boolean  @default(false)
  /// What this client is billed for by default: "goods" or "service".
  /// Drives the 349 clave (E vs S) and, for Northern Ireland (XI), the
  /// territory class. Most SaaS clients buy services. See src/tax/territory.ts.
  nature      String   @default("service")
  /// True for Canarias / Ceuta / Melilla — Spain by ISO code (`ES`) but
  /// outside the IVA zone (territory class ES_NO_IVA). Cannot be inferred
  /// from countryCode alone, so it's an explicit flag.
  esNoIva     Boolean  @default(false)
  email       String?
  /// ISO 4217 currency this client is invoiced in. Null = use the
  /// account's Company.baseCurrency. Non-EUR is only allowed on 0%-VAT
  /// (non-Spanish) invoices — enforced at invoice create time.
  currency    String?
  // --- Structured postal address (user types these directly now) ---
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  region       String?
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([companyId])
  @@index([companyId, archivedAt])
  @@map("contacts")
}

model Invoice {
  id              String   @id @default(cuid())
  companyId       String
  contactId       String?
  /// Optional FK to the per-company bank account selected on the
  /// wizard's "Bank account" step. When set, the PDF "Payment details"
  /// block renders that account; when null, the block is omitted.
  bankAccountId   String?

  // --- Numbering ---
  // Number + serialIndex are nullable on DRAFTs. Spanish law requires
  // sent invoices to be sequentially numbered without gaps — to
  // honour that, the FACT-YYYY-NNNNN number is allocated atomically
  // at SUBMIT time (inside the same txn as VerifactuRegistry), and
  // released back to NULL if AEAT rejects. That way DRAFTs the user
  // never sends don't consume serial numbers and don't punch holes
  // in the sequence AEAT sees.
  number          String?  // null on DRAFT; "FACT-YYYY-NNNNN" once allocated
  serialYear      Int      // year from issueDate; set on create for the index below
  serialIndex     Int?     // null on DRAFT; monotonic per (company, year) once allocated
  series          String   @default("FACT") // letter prefix; future-proof for multiple series

  // --- Dates ---
  issueDate DateTime @db.Date
  dueDate   DateTime? @db.Date

  // --- Counterparty snapshot at issue time (PDF stability) ---
  contactSnapshot Json     // { lines: string[], name, taxId, countryCode, isEu }
  emitterSnapshot Json     // snapshot of Company emitter fields used in the PDF

  // --- Money ---
  // netAmount/vatAmount/totalAmount/toPayAmount are in the invoice
  // `currency` (the recipient's currency) — that's what the PDF and the
  // dashboard show. VeriFactu must report EUR, so the *Eur mirror below
  // holds the EUR equivalents that the AEAT submission + Huella read.
  currency        String   @default("EUR") // ISO 4217 of the figures below
  language        String   @default("en") // "en" | "en_eu" | "es"
  /// "goods" | "service" — what was supplied. Drives the 349 clave
  /// (E = intra-EU goods, S = intra-EU services) and 303 routing. Also
  /// mirrored into contactSnapshot at issue time for PDF/audit stability.
  nature          String   @default("service")
  vatRate         Decimal  @db.Decimal(5, 2) // 0 or 21
  irpfRate        Decimal  @db.Decimal(5, 2) @default(0) // 0, 7, or 15
  netAmount       Decimal  @db.Decimal(12, 2)
  vatAmount       Decimal  @db.Decimal(12, 2)
  irpfAmount      Decimal  @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal  @db.Decimal(12, 2) // net + vat
  toPayAmount     Decimal  @db.Decimal(12, 2) // total - irpf
  // --- EUR mirror for VeriFactu ---
  // EUR equivalents of net/vat/total. Populated on every new invoice
  // (== the amounts above when currency is EUR; manually entered per
  // line when currency != EUR). Nullable so legacy pre-feature rows
  // read back as null and the submit/hash code falls back to the plain
  // amount (which was EUR for every invoice issued before this feature).
  netAmountEur    Decimal? @db.Decimal(12, 2)
  vatAmountEur    Decimal? @db.Decimal(12, 2)
  totalAmountEur  Decimal? @db.Decimal(12, 2)
  // FX rate + its reference date used to derive the EUR mirror when
  // currency != EUR. Rate = EUR per 1 unit of `currency` at the devengo
  // date (tipo de cambio publicado por el BCE/BOE en la fecha de devengo,
  // NOT the payment date). Stored for audit so the mirror is reproducible.
  fxRate          Decimal? @db.Decimal(18, 8)
  fxRateDate      DateTime? @db.Date

  // --- Lifecycle ---
  // "DRAFT" → invoice exists in our DB only, no registry, no AEAT
  //  submission. Free to edit/delete.
  // "SENT"  → submitted to and accepted by AEAT (CSV stored on the
  //  registry row). Locked; the Huella chain protects the linked
  //  registry row from any mutation.
  // No SEND_FAILED state — failed submissions roll back the registry
  // row entirely so the chain doesn't reference a record AEAT didn't
  // accept. The invoice stays DRAFT and the UI shows the error modal.
  status          String   @default("DRAFT")

  // --- Payment ---
  paid            Boolean  @default(false)
  paidAt          DateTime?
  paymentMethod   String?  // free text: Stripe, Wise, SEPA, Cash, ...

  // --- Content ---
  description     String   // legacy single-line; lines model added for multi-line
  notes           String?  // free-form notes / legal footer override
  legalNoteCode   String?  // "art69" | "reverseCharge" | null — drives the boilerplate

  // --- PDF artifact ---
  pdfS3Key        String?  // S3 object key; null until generated
  pdfGeneratedAt  DateTime?
  // SHA-256 of the rendered PDF bytes. Lets us detect tampering / S3
  // corruption (rehash on download); also seeds the Verifactu chain.
  pdfSha256       String?

  // --- Verifactu (RD 1007/2023) ---
  // 1:1 with VerifactuRegistry. Optional because the registry is only
  // populated when VERIFACTU_MODE != "disabled" — pre-2026-07-01 default.
  verifactuRegistry VerifactuRegistry?
  events           InvoiceEvent[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]

  @@unique([companyId, number])
  @@unique([companyId, serialYear, serialIndex])
  @@index([companyId, issueDate])
  @@index([companyId, paid])
  @@map("invoices")
}

/// Append-only audit timeline for an invoice. Every meaningful state
/// transition — creation, PDF render, Verifactu submit attempt, AEAT
/// response, rollback — writes a row here. Two purposes:
///
///   1. Forensic: if AEAT inspects in 4 years, we can reconstruct
///      exactly what XML we sent and what they returned. The
///      `payload` JSON stores raw SOAP envelopes verbatim.
///   2. UX: the dashboard renders this as a per-invoice timeline so
///      the user understands why something is in DRAFT after a
///      rejection (the rollback event explains it).
///
/// Rows are immutable — we never UPDATE or DELETE individually.
/// onDelete: Cascade with Invoice means deleting a draft purges its
/// events too (intentional — drafts have no legal retention duty).
model InvoiceEvent {
  id          String   @id @default(cuid())
  invoiceId   String
  /// Denormalised for tenant filtering — querying "all events for
  /// company X" is the dashboard's job and we avoid a join.
  companyId   String

  /// Event taxonomy. Plain string (not enum) so adding new event
  /// types is a one-line code change with no DB migration.
  /// Current values:
  ///   - INVOICE_CREATED
  ///   - PDF_GENERATED
  ///   - VERIFACTU_SUBMIT_REQUEST  (we POSTed to AEAT)
  ///   - VERIFACTU_SUBMIT_RESPONSE (AEAT accepted, CSV stored)
  ///   - VERIFACTU_SUBMIT_REJECTED (AEAT returned an error code)
  ///   - VERIFACTU_SUBMIT_NETWORK_ERROR
  ///   - VERIFACTU_REGISTRY_ROLLBACK
  type        String

  /// "ok" (success) | "error" (failure) | "info" (neutral). Drives
  /// the colour/icon in the timeline UI without us having to map
  /// every event type to a colour client-side.
  outcome     String

  /// One-line human-readable summary. Shown as the row title in
  /// the timeline. Examples:
  ///   "Submitted to AEAT — FACT-2026-00001"
  ///   "Accepted (CSV A-ZT6WR34SY4FB2T)"
  ///   "Rejected (code 1189): Destinatarios mandatory for F1"
  summary     String   @db.Text

  /// Free-form details. For VERIFACTU_SUBMIT_REQUEST this is the
  /// raw SOAP envelope; for VERIFACTU_SUBMIT_RESPONSE it includes
  /// AEAT's full XML + parsed result. Stored as Json so jsonb
  /// indexing remains an option if we ever need to grep events
  /// by AEAT code at scale.
  payload     Json?

  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@map("invoice_events")
}

/// Line items on an invoice. MVP creates one row mirroring legacy "1. ...".
/// Schema is ready for multi-line invoices (Xolo / Quipu parity).
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  sortOrder   Int      @default(0)
  description String
  quantity    Decimal  @db.Decimal(12, 2) @default(1)
  unit        String?  // "pc", "ud", "h", ...
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  /// Manual EUR equivalent of this line's total, entered by the user
  /// when the invoice currency != EUR. Summed into Invoice.netAmountEur
  /// so VeriFactu reports EUR. Null when the invoice is already in EUR.
  totalEur    Decimal? @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// Received/purchase invoice (factura recibida / gasto). The mirror of
/// Invoice on the input side: what the company PAYS. Needed to compute
/// the deductible IVA (soportado) for Modelo 303 and the deductible
/// expenses for the Modelo 130 pago fraccionado. Unlike Invoice there's
/// no legal numbering/VeriFactu duty here — these are the counterparty's
/// documents, we only record them for the quarterly declarations helper.
///
/// Supplier data is stored inline (no Contact FK) — suppliers are entered
/// ad-hoc when logging a receipt and rarely reused, so a snapshot keeps
/// the model self-contained.
model Expense {
  id            String   @id @default(cuid())
  companyId     String

  // --- Supplier (proveedor) ---
  supplierName        String
  supplierTaxId       String?  // NIF / VAT of the supplier
  supplierCountryCode String?  // ISO 3166-1 alpha-2
  supplierIsEu        Boolean  @default(false)
  /// "goods" | "service" — what was acquired. Distinguishes 349 clave A
  /// (intra-EU goods) from I (intra-EU services). Ads/Cloud/SaaS = service.
  /// This axis was missing entirely (bug C-1): everything was treated as
  /// goods, so service acquisitions went out as clave A.
  nature      String   @default("service")
  /// Supplier in Canarias / Ceuta / Melilla — Spain but outside the IVA
  /// zone (territory class ES_NO_IVA). Explicit, see src/tax/territory.ts.
  supplierEsNoIva Boolean @default(false)

  // --- Document ---
  issueDate   DateTime @db.Date // fecha de la factura del proveedor
  /// "invoice"              → an ordinary expense backed by a supplier invoice.
  /// "recurring_no_invoice" → a recurring charge with NO invoice document,
  ///   e.g. the autónomo's monthly TGSS/RETA social-security quota (bug C-5).
  ///   These are deductible for IRPF (Modelo 130) but carry no deductible IVA.
  kind        String   @default("invoice")
  category    String?           // free-form bucket for future analytics
  description String?
  notes       String?

  // --- Money (figures in `currency`) ---
  currency    String   @default("EUR") // ISO 4217
  netAmount   Decimal  @db.Decimal(12, 2)               // base imponible
  vatRate     Decimal  @db.Decimal(5, 2) @default(21)   // 0 / 4 / 10 / 21
  vatAmount   Decimal  @db.Decimal(12, 2)               // IVA soportado
  irpfRate    Decimal  @db.Decimal(5, 2) @default(0)    // retención practicada
  irpfAmount  Decimal  @db.Decimal(12, 2) @default(0)   // (feeds a future 111)
  totalAmount Decimal  @db.Decimal(12, 2)               // net + vat − irpf

  // --- EUR mirror (declarations aggregate in EUR, like VeriFactu) ---
  netAmountEur   Decimal? @db.Decimal(12, 2)
  vatAmountEur   Decimal? @db.Decimal(12, 2)
  totalAmountEur Decimal? @db.Decimal(12, 2)
  // FX rate + reference date used to derive the EUR mirror when currency
  // != EUR. Rate = EUR per 1 unit of `currency` at the devengo date
  // (BCE/BOE published rate, not the payment date). e.g. a NOK invoice
  // stores the original NOK amount, the rate, its date, and the EUR mirror.
  fxRate         Decimal? @db.Decimal(18, 8)
  fxRateDate     DateTime? @db.Date

  // Percentage of the IVA soportado that is actually deductible. Fuel,
  // phone, mixed personal/business items are often <100. Default 100.
  deductibleVatPct Decimal @db.Decimal(5, 2) @default(100)
  // Whether this expense is deductible for IRPF (Modelo 130 box 02).
  // Almost always true; set false for non-deductible items kept only for
  // bookkeeping. TGSS/RETA (kind=recurring_no_invoice) is deductible here.
  deductibleForIrpf Boolean @default(true)

  // Intra-EU acquisition → IVA autorepercutido (reverse charge): the VAT
  // is self-assessed and appears in BOTH the devengado (output) and the
  // deducible (input) side of Modelo 303 — net zero when fully deductible.
  // Also feeds Modelo 349 as an "A" (adquisición intracomunitaria) op.
  reverseCharge Boolean @default(false)

  // --- Source document (the supplier's invoice/receipt), stored in S3 ---
  // The uploaded image/PDF the expense was created from. Kept so everything
  // lives in one place and the AI parse is auditable against the original.
  fileS3Key String?
  fileMime  String?
  fileName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, issueDate])
  @@map("expenses")
}

/// A tax return the user has ALREADY filed with AEAT. The declarations
/// engine is otherwise stateless (it recomputes every quarter from the
/// invoices/expenses), but two boxes legally must read the *filed* history
/// rather than a recomputation:
///   - Modelo 130 box 05 (pagos de trimestres anteriores) = the box-07
///     amounts actually paid in prior quarters of the same year. Bug 130-2:
///     the engine recomputed prior quarters (with zero expenses) instead of
///     reading what was filed, so box 05 was wrong even when the total was
///     coincidentally right.
///   - Modelo 303 boxes 110/78/87 (cuotas a compensar): the pending balance
///     carried from the previous period. Bug 303-7.
/// The user records each filed return here (manually or by uploading the
/// AEAT PDF and letting the AI autofill it, like expenses). The engine reads
/// `casillas` / the denormalised figures below.
model FiledDeclaration {
  id        String @id @default(cuid())
  companyId String

  model   String // "303" | "130" | "349"
  year    Int
  quarter Int    // 1..4

  justificante String?   // AEAT "número de justificante" from the receipt
  submittedAt  DateTime? @db.Date

  /// Full box map as filed, e.g. { "07": 2674.04, "17": 2674.04 } for a 130
  /// or { "71": -18.64, "87": 18.64 } for a 303. Model-specific; the engine
  /// reads the boxes it needs and this stays the audit record of the rest.
  casillas Json @default("{}")

  /// Denormalised figures the engine reads directly (kept in sync with
  /// `casillas` on write):
  ///   130 → resultPaid = box 07 (what feeds next quarter's box 06/05).
  ///   303 → resultPaid = box 71; compensarNext = box 87 (a compensar).
  resultPaid    Decimal? @db.Decimal(12, 2)
  compensarNext Decimal? @db.Decimal(12, 2)

  // --- Source document (the AEAT PDF), stored in S3 like an expense doc ---
  fileS3Key String?
  fileMime  String?
  fileName  String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, model, year, quarter])
  @@index([companyId, year])
  @@map("filed_declarations")
}

model SupportMessage {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  message   String   @db.Text
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    FacturaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("support_messages")
}

/// Verifactu registry row — one per Invoice when VERIFACTU_MODE != disabled.
/// Implements the tamper-evident hash chain mandated by RD 1007/2023:
/// every row's `currentHash` includes the previous row's hash, so any
/// mutation to a past row invalidates every subsequent hash.
///
/// `aeatStatus` tracks the lifecycle of the AEAT submission:
///   PENDING — registry persisted, not yet sent (or submit disabled)
///   OK      — AEAT accepted the registro de facturación
///   RETRY   — transient error, the cron will retry
///   FAILED  — non-recoverable rejection from AEAT (schema, signature, etc.)
///
/// QR code printed on every PDF points at the AEAT verification page that
/// looks the invoice up by NIF + serie + fecha + importe. Sandbox uses
/// prewww1.aeat.es; production www1.aeat.es.
model VerifactuRegistry {
  id                String   @id @default(cuid())
  companyId         String
  invoiceId         String   @unique

  // Monotonic per company; uniqueness enforced so the chain can't fork.
  sequenceNumber    Int
  // Empty string for the very first record of a company. Chain seed.
  previousHash      String
  // Uppercase hex SHA-256 of `hashInput`.
  currentHash       String
  // The canonicalised string that was hashed. Stored verbatim so a
  // future AEAT audit can recompute the hash without recomputing the
  // canonicalisation rules — those rules are pinned per the RD spec
  // that was current at issue time.
  hashInput         String   @db.Text

  // F1 = Factura completa (default), F2 = Factura simplificada, etc.
  // We only emit F1 today; field stored for future expansion.
  tipoFactura       String   @default("F1")
  // Pre-built QR-code URL embedded in the PDF.
  qrUrl             String   @db.Text

  // AEAT submission state — populated by the submit cron.
  aeatStatus        String   @default("PENDING")
  aeatSubmittedAt   DateTime?
  aeatResponseCode  String?
  aeatResponseRaw   Json?
  aeatRetryCount    Int      @default(0)

  signedAt          DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([companyId, sequenceNumber])
  @@index([companyId, signedAt])
  @@index([aeatStatus, aeatRetryCount])
  @@map("verifactu_registries")
}

// ===== Чат с моделью ИИ (раздел «Чат») =====
// Ключ провайдера (xAI) живёт в окружении сервера (GROK_API_KEY) и на клиент не уходит:
// запросы к модели идут через сервер, поэтому ключ не лежит в сборке приложения, расход виден
// в логах сервера, а история переписки — в БД и доступна с любого устройства.

/// Диалог с моделью: тема, выбранная модель и сообщения.
model AiChat {
  id        String      @id @default(uuid())
  userId    String
  // Тема чата. Своей темы у модели не спрашивают: она выводится из первого вопроса, как это
  // делают приложения ChatGPT и Gemini — иначе список чатов состоял бы из одинаковых «Новый чат».
  title     String      @default("Новый чат")
  // Идентификатор модели, который уходит провайдеру в поле `model`.
  //
  // По умолчанию — grok-4.20-0309-non-reasoning: он не тратит токены на «размышления», и в
  // нашем чате короткий ответ стоит около $0.0013 против $0.003 у флагмана (см. комментарий к
  // DEFAULT_AI_MODEL и миграцию 20260918180000). Флагман остаётся в выборе шапки переписки.
  model     String      @default("grok-4.20-0309-non-reasoning")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  // Список чатов всегда берётся по владельцу и сортируется по времени последнего сообщения —
  // под этот запрос индекс и заведён.
  @@index([userId, updatedAt])
  @@map("ai_chats")
}

/// Настройки раздела «Чат» у владельца: то, что подмешивается в каждый запрос.
///
/// Отдельной таблицей, а не полем в `User`: это состояние одного раздела, и в общем профиле
/// ему места нет. Строка одна на пользователя (`userId` — первичный ключ).
model AiSettings {
  userId    String   @id
  // Память: свободный текст владельца о себе и о том, как отвечать. Уходит в системную часть
  // каждого запроса, поэтому модель знает контекст разговора без повторений в каждом сообщении.
  memory    String   @default("") @db.Text
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

/// Сообщение диалога: вопрос человека или ответ модели.
model AiMessage {
  id     String @id @default(uuid())
  chatId String
  // 'user' | 'assistant' — те же имена ролей, что понимает API провайдера: их не приходится
  // переводить при сборе контекста запроса.
  role   String
  content String @db.Text
  // «Размышления» reasoning-модели. Отдельным полем, а не вклейкой в content: на экране они
  // показываются отдельным сворачиваемым блоком, а в контекст следующего запроса не уходят —
  // провайдеры такого поля во входных сообщениях не принимают.
  reasoning String @default("") @db.Text
  // Расход токенов на этот ответ (у вопроса — null). Нужен, чтобы расход был виден не только
  // в логах провайдера: цена ошибки здесь — деньги, а не время.
  promptTokens     Int?
  completionTokens Int?
  // Точная стоимость ответа в долларах, как её посчитал провайдер (`cost_in_usd_ticks`).
  // Включает и токены, и вызовы поиска, поэтому по ней и считают расход по чату. У вопросов
  // человека и у ответов, сделанных до появления этой колонки, значения нет.
  costUsd          Float?
  createdAt DateTime @default(now())
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("ai_messages")
}
