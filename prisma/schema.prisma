// CloudlyRu — Prisma-схема (PostgreSQL).
// M0: пользователь/сессии, файловое дерево (soft delete), Asset = объект в S3 (дедуп по sha256).

generator client {
  provider      = "prisma-client-js"
  // прод-сервер — ARM64 (Hetzner aarch64, Ubuntu 22.04, OpenSSL 3); раннер GitHub — x64
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Пользователи, сессии, токены =====

model User {
  id            String     @id @default(uuid())
  login         String     @unique
  passwordHash  String
  createdAt     DateTime   @default(now())
  sessions      Session[]
  apiTokens     ApiToken[]
  shares        Share[]
  mailAccounts  MailAccount[]
  rootFolderId  String? // корневая папка пользователя (создаётся при seed)
  photoFolderId String? // системная папка «Фото» (медиа-зона; создаётся при seed/lazy)
  phoneFolderId String? // системная папка «Телефон» (зеркало папок телефона; создаётся lazy)
  // системная папка «Почта» (зона MAIL): вложения писем. Создаётся лениво при первом
  // обращении почтового модуля и скрыта отовсюду, поэтому в `GET /auth/me` не отдаётся.
  mailFolderId  String?
  // Буфер копирования/вырезания. В БД, а не в localStorage браузера: буфер должен быть
  // один на аккаунт — скопировал на телефоне, вставил на ноутбуке. Одна цель за раз.
  clipboardKind String? // 'file' | 'folder'
  clipboardId   String?
  clipboardMode String? // 'copy' | 'cut'
  clipboardAt   DateTime?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique // sha256 токена; сам токен живёт только в cookie
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  label      String
  tokenHash  String    @unique
  scope      String    @default("files:rw") // files:rw | files:ro (проверяется в resolveApiToken)
  expiresAt  DateTime? // null = бессрочный (легаси-токены)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  // корень зеркала этого устройства («<Имя> - Файлы»); создаётся лениво
  mirrorFolderId String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== Файловое дерево =====
// parentId всегда не-null: верхний уровень = дети корневой папки (root).
// Удаление — soft (deletedAt), hard delete только через purge (корзина, retention).

model Folder {
  id        String      @id @default(uuid())
  parentId  String? // null = верхний уровень (корень пользователя)
  name      String
  // зона: FILES (обычный диск, медиа хранится как есть) | PHOTOS (поддерево системной папки «Фото», медиа конвертируется)
  zone      String      @default("FILES")
  // легаси: флаг «держать офлайн» снят с поддержки. Колонка оставлена, чтобы не делать
  // миграцию по данным; код её больше не читает и не пишет.
  keepOffline Boolean   @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  parent    Folder?     @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]    @relation("FolderTree")
  entries   FileEntry[]

  // Postgres: NULL-ы в unique-индексе не конфликтуют — дубли на верхнем уровне ловим в сервисе
  @@unique([parentId, name])
  @@index([parentId, deletedAt])
}

model FileEntry {
  id         String      @id @default(uuid())
  folderId   String
  assetId    String
  name       String
  // зона папки на момент создания (FILES|PHOTOS) — для фильтра таймлайна и политики конвертации
  zone       String      @default("FILES")
  // mtime файла на устройстве-источнике: без него синхронизация сравнивала бы даты,
  // которые сервер не знает, и каждый скан считал бы скачанный файл «изменённым»
  clientMtime DateTime?
  // легаси-поле файла: флаг «держать офлайн» снят с поддержки, код его не использует
  keepOffline Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  folder     Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  albumItems AlbumItem[]
  // обратная сторона MailAttachment.entryId: вложение письма — обычная запись дерева
  // (в скрытой зоне MAIL), поэтому её содержимое дедуплицируется с файлами пользователя
  mailAttachment MailAttachment?

  @@unique([folderId, name])
  @@index([folderId, deletedAt])
  @@index([zone, deletedAt])
  // Проверка «это мой файл» (ownsAsset) и соединение в ленте идут по assetId. Парный индекс
  // с порядком NULLS LAST по MediaMeta.capturedAt живёт в миграции: в схеме он не выражается.
  @@index([assetId, deletedAt])
}

// Физический объект в S3 (один на уникальное содержимое)
model Asset {
  id            String      @id @default(uuid())
  sha256        String      @unique
  size          BigInt
  mime          String
  ext           String?
  createdAt     DateTime    @default(now())
  // Состояние превью: 'none' — ещё нет (задача ждёт, упала или её ещё не ставили),
  // 'done' — собраны, 'impossible' — собрать нельзя (причина в previewError).
  // Превью строятся из содержимого, поэтому состояние живёт на ассете, а не на записи в дереве.
  previewState  String      @default("none")
  previewError  String?
  // Число страниц PDF: по нему перечисляются превью страниц при удалении файла.
  pageCount     Int?
  entries       FileEntry[]
  media         MediaMeta?
  jobs          Job[]
  // сырые .eml писем: объект в S3 тот же content-addressed files/<sha256>, а строка Asset
  // нужна, чтобы объект был на учёте (иначе его снесёт deploy/scripts/sweep-orphans.mjs)
  mailRaw       MailMessage[] @relation("MailRawAsset")

  @@index([previewState])
}

// Активная загрузка файла: multipart-сессия в S3. Принятые части (partNumber + ETag)
// лежат в БД, а не в RAM: рестарт сервиса больше не теряет сессию, а complete может
// собрать объект по ETag'ам, пришедшим с клиента (прямая загрузка в S3).
model UploadSession {
  id         String   @id @default(uuid())
  userId     String
  s3UploadId String   @unique
  uploadKey  String // временный ключ объекта в S3 (files/tmp/<token>) для abort/cleanup
  folderId   String?
  name       String
  size       BigInt
  mime       String
  partCount  Int      @default(0) // сколько частей принято
  parts      Json? // [{ partNumber, etag, size }] — принятые части multipart
  // sha256, объявленный клиентом (браузер считает инкрементально до загрузки):
  // нужен для дедупа до передачи байтов и как ожидаемое значение при верификации.
  declaredSha256 String?
  direct     Boolean  @default(false) // части льются клиентом прямо в S3 (без релея через сервер)
  // Перезапись существующего файла с тем же именем: без неё зеркалирование на каждом
  // изменённом файле получало бы 409, а «удали + создай» меняло бы id записи у всех устройств
  replace    Boolean  @default(false)
  // Имя занято записью из корзины, и клиент синхронизации разрешил её занять
  // (replaceTrashed в init): запись восстанавливается и перезаписывается. Без флага
  // поведение прежнее — 409 in_trash, и файл с таким именем не уезжает в облако никогда.
  replaceTrashed Boolean @default(false)
  // mtime файла на устройстве-источнике, чтобы он попал в FileEntry при создании записи
  clientMtime DateTime?
  // Предполётное условие перезаписи (оптимистичная блокировка): клиент говорит, какую
  // версию файла он заменяет. Если на сервере уже другая — 409 со снимком текущей версии,
  // и клиент сохраняет свою копию как конфликтную, а не затирает чужую правку.
  expectedSha256    String?
  expectedUpdatedAt DateTime?
  // Сессия не удаляется сразу после complete: ретрай после потерянного ответа должен
  // получить тот же результат, а не 404 (клиент на плохой сети иначе считает загрузку провалом)
  completedAt DateTime?
  result      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

// ===== Шаринг (каркас M1) =====

enum ShareKind {
  FOLDER
  FILE
  ALBUM
}

enum ShareCapability {
  VIEW
  DOWNLOAD
  UPLOAD
  RW
}

model Share {
  id           String          @id @default(uuid())
  // владелец ссылки: без него list/update/revoke работали по одному токену,
  // то есть любой залогиненный мог увидеть и отозвать чужой шаринг
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ShareKind
  targetId     String
  token        String          @unique // 128 бит случайности
  passwordHash String?
  capability   ShareCapability @default(VIEW)
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

// ===== Аудит =====

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===== M2: медиа-метаданные (EXIF), альбомы =====

model MediaMeta {
  id         String    @id @default(uuid())
  assetId    String    @unique
  capturedAt DateTime?
  latitude   Float?
  longitude  Float?
  make       String?
  model      String?
  width      Int?
  height     Int?
  /// Полный набор извлечённых тегов (EXIF для фото / ffprobe для видео) — для деталки файла
  raw        Json?
  createdAt  DateTime  @default(now())
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Album {
  id        String      @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime    @default(now())
  items     AlbumItem[]

  @@index([userId])
}

model AlbumItem {
  id        String    @id @default(uuid())
  albumId   String
  entryId   String
  createdAt DateTime  @default(now())
  album     Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  entry     FileEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([albumId, entryId])
}

// ===== Журнал изменений дерева для клиентов синхронизации (M3) =====
// Append-only лента: клиент держит курсор по seq и применяет изменения по порядку.
// Записи НЕ связаны внешними ключами с FileEntry/Folder — смысл журнала в том, что
// tombstone переживает физическое удаление строки (trash purge), иначе клиент зальёт
// удалённый файл заново. Поля — снимок состояния цели на момент события, поэтому клиенту
// достаточно применить строку, а не восстанавливать состояние запросами.

model ChangeLog {
  seq         BigInt   @id @default(autoincrement())
  userId      String
  target      String // entry | folder
  op          String // create | update | move | delete | restore | pin
  targetId    String // id FileEntry или Folder (у tombstone — уже не существующий)
  folderId    String? // родительская папка цели на момент события
  name        String
  zone        String?
  sha256      String?
  size        BigInt?
  mime        String?
  clientMtime DateTime?
  // легаси: снимок флага «держать офлайн» в событии журнала; новые события его не пишут
  keepOffline Boolean  @default(false)
  // id ApiToken устройства, если изменение пришло от клиента синхронизации (иначе null)
  deviceId    String?
  at          DateTime @default(now())

  @@index([userId, seq])
  @@index([at])
}

// ===== Очередь конвертации (оригинал → превью) =====
// Строка = одна задача на ассет: создаётся сигналом (загрузка в «Фото», пересчёт), живёт до
// успеха (тогда удаляется) или до ошибки (остаётся, чтобы её можно было повторить).

model Job {
  id         String    @id @default(uuid())
  assetId    String
  kind       String // 'photo' | 'video' | 'pdf'
  state      String    @default("pending") // pending | processing | failed
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([assetId])
}

// ===== Пауза конвертации =====
// Одна строка (id = 1). В БД, а не в памяти воркера: пауза должна пережить рестарт
// и действовать для всех процессов сразу.

model QueueState {
  id        Int      @id @default(1)
  paused    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ===== Разархивирование архивов внутри хранилища (без диска) =====// ZIP читается из S3 по Range-запросам, файлы кладутся обратно в S3
// (content-addressed, с дедупом), в дерево добавляется папка с именем архива.

model UnzipJob {
  id             String    @id @default(uuid())
  entryId        String // FileEntry архива (.zip)
  assetId        String
  folderId       String // папка архива (родитель будущей папки с содержимым)
  targetFolderId String? // созданная папка-приёмник
  state          String    @default("pending") // pending|processing|done|failed|cancelled
  totalEntries   Int       @default(0)
  doneEntries    Int       @default(0)
  totalBytes     BigInt    @default(0)
  doneBytes      BigInt    @default(0)
  skippedEntries Int       @default(0) // уже существовали (идемпотентный перезапуск)
  cursorIndex    Int       @default(0) // чекпойнт: сколько файлов архива уже обработано
  currentName    String?
  error          String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([state, createdAt])
  @@index([entryId])
}

// ===== Почта: аккаунты, курсоры синка, письма и вложения =====
// Модель «две папки»: всё полученное (включая спам) — inbox, всё отправленное — sent.
// Папок, меток и фильтров у почты нет намеренно, поэтому папок источника много,
// а корзин у нас ровно две (см. MailCursor.box).

model MailAccount {
  id          String    @id @default(uuid())
  userId      String
  kind        String // 'gmail' | 'icloud' | 'imap' — от него зависят имена папок источника
  email       String // адрес, которым подписываются письма и по которому идёт дедуп
  imapHost    String
  imapPort    Int       @default(993)
  smtpHost    String
  smtpPort    Int       @default(465)
  login       String // логин IMAP/SMTP (у Gmail и iCloud совпадает с email, но это не гарантия)
  // app password, зашифрованный AES-256-GCM ключом MAIL_SECRET_KEY: это ключ ко всей
  // переписке, в открытом виде он не хранится и в логи не попадает.
  secretEnc   String
  // Отправка может идти через другой сервис, чем приём (у Brevo логин и ключ свои,
  // а не пароль ящика). Пусто — берём login/secretEnc: так живут Gmail и iCloud.
  smtpLogin      String?
  smtpSecretEnc  String?
  authKind    String    @default("password") // password | oauth2 (задел под Gmail API)
  enabled     Boolean   @default(true)
  status      String    @default("idle") // idle | syncing | error
  statusError String?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cursors     MailCursor[]
  messages    MailMessage[]

  @@unique([userId, email])
  @@index([userId])
}

// Курсор синхронизации по одной папке источника: пар (uidValidity, lastUid) достаточно для
// инкремента, а `box` говорит, в какую из наших двух папок раскладывать письма отсюда.
model MailCursor {
  id           String      @id @default(uuid())
  accountId    String
  imapPath     String // 'INBOX', '[Gmail]/All Mail', 'Sent Messages', …
  box          String // 'inbox' | 'sent'
  uidValidity  BigInt // сменилась — папка пересинкивается целиком
  lastUid      BigInt      @default(0)
  // Бэкфилл идёт от свежих к старым (сначала 90 дней, глубина фоном), поэтому докуда
  // дошли вглубь — это дата, а не uid.
  backfillFrom DateTime?
  backfillDone Boolean     @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  account      MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, imapPath])
  @@index([accountId])
}

model MailMessage {
  id             String    @id @default(uuid())
  userId         String
  accountId      String
  box            String // основная папка: 'inbox' | 'sent'
  // Папки сверх основной. Одно и то же письмо бывает сразу в двух: отправленное себе
  // (наша копия в «Исходящих» плюс пришедшая обратно) и две копии на сервере у iCloud
  // (INBOX и Sent Messages). Строка при этом одна — иначе задваивались бы вложения и файл .eml.
  alsoBoxes      String[] @default([])
  folderPath     String // папка источника: по ней и курсору письмо находится повторно
  uid            BigInt
  uidValidity    BigInt
  // X-GM-MSGID — стабильный идентификатор письма у Gmail: он не меняется при переносе
  // между папками, поэтому дедуп для Gmail идёт по нему, а не по uid.
  gmailMsgId     String?
  messageId      String? // Message-ID из заголовков
  threadKey      String? // X-GM-THRID либо нормализованная тема для iCloud
  subject        String?
  fromName       String?
  fromAddr       String?
  toAddrs        String[]
  ccAddrs        String[]
  replyTo        String?
  inReplyTo      String?
  refs           String[] // References из заголовков — для сборки треда
  sentAt         DateTime? // Date из заголовков (может врать и отсутствовать)
  receivedAt     DateTime // INTERNALDATE — время прихода на сервер, ему и верим
  // Ключ сортировки ленты: receivedAt для входящих, sentAt (иначе receivedAt) для исходящих.
  // Отдельной колонкой, чтобы индекс ленты не зависел от выражения COALESCE.
  sortAt         DateTime
  size           Int
  hasAttachments Boolean   @default(false)
  seen           Boolean   @default(false)
  flagged        Boolean   @default(false)
  // Первые ~2 КБ текста: превью в списке рисуется без разбора .eml из S3.
  bodyText       String?
  rawAssetId     String // Asset сырого .eml (объект files/<sha256>)
  // Удаление письма из веб-морды — soft (корзина общая с файлами); `remoteDeletedAt` — уже
  // про источник, когда копию убрали с сервера аккаунта.
  deletedAt       DateTime?
  remoteDeletedAt DateTime?
  // Сколько раз пытались убрать копию с сервера и чем кончилось. Нужно для разбора: без этих
  // полей «письмо почему-то не удаляется» выяснять неоткуда, а молчаливые повторы бесконечны.
  remotePurgeTries Int       @default(0)
  remotePurgeError String?
  createdAt      DateTime  @default(now())
  account        MailAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rawAsset       Asset           @relation("MailRawAsset", fields: [rawAssetId], references: [id], onDelete: Restrict)
  attachments    MailAttachment[]

  // Идемпотентность повторного прохода по папке: то же письмо не заводится второй раз.
  @@unique([accountId, folderPath, uidValidity, uid])
  // Лента: свежие сверху; порядок совпадает с индексом (NULL в sortAt не бывает).
  @@index([userId, box, sortAt(sort: Desc), id(sort: Desc)])
  // Индекса по (accountId, gmailMsgId) здесь нет намеренно: в миграции он объявлен
  // УНИКАЛЬНЫМ и частичным (WHERE gmailMsgId IS NOT NULL) — так дедуп защищён на уровне БД,
  // а в схеме частичный уникальный индекс не выражается.
  @@index([accountId, messageId])
  @@index([deletedAt])
}

// Вложение письма = обычная запись дерева в скрытой зоне MAIL плюс связь с письмом.
// Через `entryId` файл открывается деталкой (превью, размер, скачивание), через
// `messageId` — обратный переход «файл → письмо».
model MailAttachment {
  id        String   @id @default(uuid())
  messageId String
  entryId   String   @unique
  // Порядковый номер части в разобранном письме. Путь MIME ('1.2') тут не годится: разбор
  // идёт через mailparser, который пути не отдаёт, а саму часть мы сохраняем в S3 — искать
  // её повторно в .eml не нужно.
  partIndex Int
  filename  String // исходное имя из письма (запись дерева носит имя с приставкой даты)
  mime      String
  size      Int
  contentId String? // Content-ID инлайн-картинки: по нему подменяется cid: в HTML письма
  inline    Boolean  @default(false)
  createdAt DateTime @default(now())
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  entry     FileEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([messageId, partIndex])
  @@index([messageId])
}

// Логотип отправителя: favicon домена, вытащенный сервером и закэшированный в БД.
// Фетч — только с сервера (клиент наружу не ходит), поэтому логотипы приватны, а не
// трекинг через сторонний сервис. bytes = null — у домена favicon нет (или не картинка);
// triedAt хранит последнюю попытку, чтобы не дёргать один и тот же домен на каждое письмо.
model SenderFavicon {
  domain    String   @id
  bytes     Bytes? // favicon; null — не нашёлся
  mime      String?
  triedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}
