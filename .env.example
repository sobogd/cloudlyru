# ============================================================
# CloudlyRu — конфигурация. Скопируйте на сервер в .env (chmod 600).
# Значения НИКОГДА не коммитим: в репо только этот шаблон.
# ============================================================

NODE_ENV=production
PORT=8305
BASE_URL=https://files.iq-factura.com

# Postgres (создать: createuser cloudly -P && createdb -O cloudly cloudly)
DATABASE_URL=postgresql://cloudly:CHANGE_ME@127.0.0.1:5432/cloudly

# Сессии
SESSION_SECRET=CHANGE_ME_64_hex_chars
SESSION_TTL_DAYS=30
# Срок жизни app-токена (WebDAV/Finder), дней. Токены старше срока приложением отвергаются.
API_TOKEN_TTL_DAYS=180
COOKIE_NAME=cl_session

# Первичный админ (создаётся автоматически при первом старте, если User нет)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_initial_password

# Hetzner Object Storage (бакет cloudlyru @ NBG1)
S3_FILES_ACCESS_KEY=
S3_FILES_SECRET_KEY=
S3_FILES_ENDPOINT=https://nbg1.your-objectstorage.com
S3_FILES_REGION=nbg1
S3_FILES_BUCKET=cloudlyru
# Префикс ключей в бакете. Прод — пусто. Локальный/тестовый инстанс должен задать свой
# (например dev-test/), иначе он пишет в прод-бакет, а строки файлов держит в отдельной
# БД: при её пересоздании объекты остаются в бакете «зомби» — приложению они уже
# не видны (такие чистит deploy/scripts/sweep-orphans.mjs).
S3_FILES_PREFIX=
S3_FILES_FORCE_PATH_STYLE=true

# Загрузки
# Чанк релей-пути (через сервер): используется как фолбэк, если браузер не может
# заливать части прямо в S3 (нет CORS-правила на бакете и т.п.).
UPLOAD_CHUNK_MAX_MB=20
# Часть при прямой загрузке в S3 (браузер → S3, минуя сервер). 16 МБ × 3 потока
# на клиенте = ~48 МБ памяти браузера; крупнее — меньше round-trip'ов на высоком пинге.
UPLOAD_DIRECT_PART_MB=16
# Срок жизни presigned-ссылки на часть (мин). Ссылка подписана на один номер части.
UPLOAD_PART_URL_TTL_MIN=15
# 64 ГиБ: архивы Google Takeout по 50 ГиБ на границе могут слегка превышать 50 ГиБ
# (наблюдали 53.69 ГБ) — при 51200 МБ такие архивы отвергались «file too large».
MAX_FILE_SIZE_MB=65536
TRASH_RETENTION_DAYS=30

# Конвертация медиа (зона «Фото»): только превью, оригинал остаётся мастером.
# Фото → 512 WebP (список) + 2048 AVIF (полный экран); видео → постер WebP + 1080 AV1.
CONVERT_ENABLED=true
# Лимит виртуальной памяти на один внешний процесс (ffmpeg и т.п.), МБ.
# ВНИМАНИЕ: это RLIMIT_AS (адресное пространство), а не RSS. libaom-av1 упирается в него,
# когда держит полноразмерные кадры (полный 4K-мастер падал при реальном RSS ~0.6 ГБ:
#   "Failed to initialize encoder: Memory allocation error").
# Превью 1080 от 4K-источника проходят: энкодер работает с даунскейлом.
CONVERT_MEM_MB=1536

# Сколько фото конвертировать параллельно. Фото упираются в ядра (AVIF-энкод и heif-convert),
# поэтому имеет смысл ставить примерно по числу ядер: 2 — на двухъядерной машине, 3–4 — на
# четырёхъядерной. Видео и PDF идут по одному независимо от этого значения: AV1-энкод
# забирает все ядра, и второй такой процесс только замедлил бы оба.
CONVERT_PHOTO_PARALLEL=1

# Пускать видео параллельно фото. По умолчанию false, потому что AV1-энкод занимает все ядра:
# параллельно с ним фото собираются в разы медленнее (замер: 3,4 с против 19,4 с на фото),
# то есть одно длинное видео растягивает превью всей библиотеки. true имеет смысл на машине
# с большим числом ядер, где фото-слоты не забирают всё.
CONVERT_VIDEO_ALONGSIDE_PHOTOS=false
# Хранить оригинал в S3. Оригинал — мастер, из него отдаётся скачивание и «оригинал»,
# и только у него есть ICC/gain map/MPF/depth и полный набор EXIF.
# false имеет смысл только если превью полностью заменяют исходник.
KEEP_ORIGINALS=true

# (deploy trigger test)

# (deploy trigger test 2)

# Потолок одновременных незавершённых загрузок на пользователя (M3, мобильный клиент)
MAX_UPLOAD_SESSIONS_PER_USER=16

# ===== Почта (раздел «Почта») =====

# Ключ шифрования паролей почтовых аккаунтов (AES-256-GCM), 32 байта в hex.
# Сгенерировать на сервере: openssl rand -hex 32
# Сами app-пароли в .env НЕ хранятся: они вводятся в веб-интерфейсе и ложатся в БД
# зашифрованными этим ключом. Потеря ключа = придётся заново ввести пароли аккаунтов.
MAIL_SECRET_KEY=

# Синхронизация с серверами почты (IMAP). Выключено — почта не ходит вообще.
MAIL_SYNC_ENABLED=false
# Как часто делать плановый проход по папкам, секунды (IDLE даёт мгновенный приход,
# это — страховка на случай разорванного соединения).
MAIL_SYNC_INTERVAL_SEC=300
# Нижняя граница истории, дни: старше не забираем. 0 — без ограничения (история идёт
# назад, пока она есть). Письма идут от свежих к старым, поэтому интерфейс наполняется
# с первого прохода, а глубина добирается фоном.
MAIL_BACKFILL_DAYS=0
# Сколько писем истории забирать за один проход. У Gmail лимит на скачивание по IMAP
# (порядка 2.5 ГБ в сутки на аккаунт), поэтому история идёт порциями.
MAIL_BACKFILL_PER_PASS=200
# Потолок трафика одного прохода, МБ.
MAIL_PASS_BUDGET_MB=300
# Потолок одновременных IMAP-соединений (по одному на аккаунт + IDLE).
MAIL_MAX_CONNECTIONS=4

# Удаление писем с сервера аккаунта после того, как они сохранены у нас.
# ВНИМАНИЕ: безвозвратно. Включать только после проверенного восстановления из бэкапа.
MAIL_PURGE_ENABLED=false
# Карантин между «сохранено у нас» и «удалено с сервера», часы.
MAIL_PURGE_QUARANTINE_HOURS=168
# Сколько писем удалять за прогон (порциями безопаснее: видно результат и можно остановиться).
MAIL_PURGE_PER_RUN=200
# Предохранитель: если под удаление попадает больше этой доли ящика (в процентах) и писем
# больше сотни, прогон отказывается работать — защита от ошибки в отборе.
MAIL_PURGE_MAX_SHARE=50
# Адреса, письма от которых не удаляем никогда: коды входа и оповещения о безопасности.
MAIL_PURGE_PROTECT_SENDERS=accounts.google.com,google.com,apple.com,id.apple.com,icloud.com
# Сколько последних писем в папке-мусорке просматривать за прогон.
MAIL_PURGE_TRASH_SCAN=2000
