# ============================================================
# CloudlyRu — конфигурация. Скопируйте на сервер в .env (chmod 600).
# Значения НИКОГДА не коммитим: в репо только этот шаблон.
# ============================================================

NODE_ENV=production
PORT=8305
BASE_URL=https://files.iq-factura.com

# Postgres (создать: createuser cloudly -P && createdb -O cloudly cloudly)
DATABASE_URL=postgresql://cloudly:CHANGE_ME@127.0.0.1:5432/cloudly

# Сессии. Ключа-секрета здесь нет: cookie — это 32 случайных байта, в БД лежит их sha256
# (SESSION_SECRET раньше стоял тут, но код его не читал ни разу).
SESSION_TTL_DAYS=30
# Срок жизни app-токена (WebDAV/Finder), дней. Токены старше срока приложением отвергаются.
API_TOKEN_TTL_DAYS=180
COOKIE_NAME=cl_session

# Уровень логирования: error | warn | log | debug | verbose. На 'debug'/'verbose' пишется
# и лог запросов (на 'log' — только медленные), на 'log' его нет намеренно: чанки релея
# загрузки — это тысячи запросов на один файл.
LOG_LEVEL=log
# Лимит запросов в минуту на IP для ручек без явного @RateLimit. 0 — выключить дефолт.
RATE_LIMIT_DEFAULT_PER_MIN=1200

# Первичный админ (создаётся автоматически при первом старте, если User нет).
# В проде оба значения обязательны, и пароль не может быть 'admin', 'CHANGE_ME*' или равным
# логину — иначе приложение откажется стартовать. Пароль короче 12 символов допускается,
# но пишет предупреждение в лог.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_initial_password

# Hetzner Object Storage (бакет cloudlyru @ NBG1)
S3_FILES_ACCESS_KEY=
S3_FILES_SECRET_KEY=
S3_FILES_ENDPOINT=https://nbg1.your-objectstorage.com
S3_FILES_REGION=nbg1
S3_FILES_BUCKET=cloudlyru
# Префикс ключей в бакете. Прод — пусто. Локальный/тестовый инстанс должен задать свой
# (например dev-test/), иначе он пишет в прод-бакет, а строки файлов держит в отдельной
# БД: при её пересоздании объекты остаются в бакете «зомби» — приложению они уже
# не видны (такие чистит deploy/scripts/sweep-orphans.mjs).
S3_FILES_PREFIX=
S3_FILES_FORCE_PATH_STYLE=true

# Загрузки
# Чанк релей-пути (через сервер): используется как фолбэк, если браузер не может
# заливать части прямо в S3 (нет CORS-правила на бакете и т.п.).
UPLOAD_CHUNK_MAX_MB=20
# Часть при прямой загрузке в S3 (браузер → S3, минуя сервер). 16 МБ × 3 потока
# на клиенте = ~48 МБ памяти браузера; крупнее — меньше round-trip'ов на высоком пинге.
UPLOAD_DIRECT_PART_MB=16
# Срок жизни presigned-ссылки на часть (мин). Ссылка подписана на один номер части.
UPLOAD_PART_URL_TTL_MIN=15
# 64 ГиБ: архивы Google Takeout по 50 ГиБ на границе могут слегка превышать 50 ГиБ
# (наблюдали 53.69 ГБ) — при 51200 МБ такие архивы отвергались «file too large».
MAX_FILE_SIZE_MB=65536
TRASH_RETENTION_DAYS=30

# Распаковка ZIP. Архив — единственная ручка, где объём работы задаёт сам загруженный файл,
# поэтому у неё свои потолки: проверки идут по центральному каталогу ДО распаковки, то есть
# zip-бомба отсекается без чтения байтов. Нулевые значения не предусмотрены — это защита,
# а не настройка вкуса. Значения ниже — дефолты из src/unzip/unzip.limits.ts.
# Сколько записей каталога принимаем (20 000 — с запасом на выгрузки Takeout).
UNZIP_MAX_ENTRIES=20000
# Потолок суммарного распакованного объёма задачи, МБ (100 ГиБ).
UNZIP_MAX_TOTAL_MB=102400
# Во сколько раз распакованное может превысить сам архив (бомба — это тысячи крат).
UNZIP_MAX_RATIO=200
# Коэффициент на одну запись: выше — запись пропускается, задача продолжается.
UNZIP_MAX_ENTRY_RATIO=1000
# Потолок глубины вложенности папок внутри архива.
UNZIP_MAX_DEPTH=32
# Сколько папок может создать один архив.
UNZIP_MAX_FOLDERS=10000
# Буфер чтения/записи при распаковке, МБ (умножается на параллельные задачи).
UNZIP_BUFFER_LIMIT_MB=64
# Сколько раз задача может «перезапуститься» после падения процесса: когда предел исчерпан,
# задача снимается в failed вместо бесконечного crash-loop всего API.
UNZIP_MAX_RESTARTS=2

# WebDAV (Finder, rclone) ходит Basic-аутентификацией: логин в ней раньше игнорировался —
# годился любой, лишь бы пароль (device-токен) был верным. true — требовать и логин тоже.
# По умолчанию false, чтобы уже настроенные клиенты не получили 401 после обновления.
DAV_VALIDATE_LOGIN=false


# Конвертация медиа (зона «Фото»): только превью, оригинал остаётся мастером.
# Фото → 512 WebP (список) + 2048 AVIF (полный экран); видео → постер WebP + 1080 H.264
# (CONVERT_VIDEO_CODEC=av1 возвращает AV1).
CONVERT_ENABLED=true
# Лимит виртуальной памяти на один внешний процесс (ffmpeg и т.п.), МБ.
# ВНИМАНИЕ: это RLIMIT_AS (адресное пространство), а не RSS. libaom-av1 упирается в него,
# когда держит полноразмерные кадры (полный 4K-мастер падал при реальном RSS ~0.6 ГБ:
#   "Failed to initialize encoder: Memory allocation error").
# На проде 1536 МБ оказалось мало и для превью: процесс стоял на 99.6% лимита при RSS 0.5 ГБ,
# то есть потолок резал не память, а потоки энкодера. 3072 — с запасом под любой кодек.
CONVERT_MEM_MB=3072
# Кодек превью видео: h264 — быстро (libx264 veryfast crf 20, играется везде), av1 — легче файл,
# но энкод на порядок дороже (libaom realtime).
CONVERT_VIDEO_CODEC=h264

# Сколько фото конвертировать параллельно. Фото упираются в ядра (AVIF-энкод и heif-convert),
# поэтому имеет смысл ставить примерно по числу ядер: 2 — на двухъядерной машине, 3–4 — на
# четырёхъядерной. Видео и PDF идут по одному независимо от этого значения: AV1-энкод
# забирает все ядра, и второй такой процесс только замедлил бы оба.
CONVERT_PHOTO_PARALLEL=1

# Пускать видео параллельно фото. По умолчанию false, потому что AV1-энкод занимает все ядра:
# параллельно с ним фото собираются в разы медленнее (замер: 3,4 с против 19,4 с на фото),
# то есть одно длинное видео растягивает превью всей библиотеки. true имеет смысл на машине
# с большим числом ядер, где фото-слоты не забирают всё.
CONVERT_VIDEO_ALONGSIDE_PHOTOS=false
# Хранить оригинал в S3. Оригинал — мастер, из него отдаётся скачивание и «оригинал»,
# и только у него есть ICC/gain map/MPF/depth и полный набор EXIF.
# false имеет смысл только если превью полностью заменяют исходник.
KEEP_ORIGINALS=true

# (deploy trigger test)

# (deploy trigger test 2)

# Потолок одновременных незавершённых загрузок на пользователя (M3, мобильный клиент)
MAX_UPLOAD_SESSIONS_PER_USER=16

# ===== Почта (раздел «Почта») =====

# Ключ шифрования паролей почтовых аккаунтов (AES-256-GCM), 32 байта в hex.
# Сгенерировать на сервере: openssl rand -hex 32
# Сами app-пароли в .env НЕ хранятся: они ложатся в БД зашифрованными этим ключом.
# Ручки создания аккаунта в API нет: строку MailAccount заводят вручную, а secretEnc обязан
# быть результатом encryptSecret() из src/mail/mail-crypto.ts. Потеря ключа = придётся заново
# ввести пароли аккаунтов.
MAIL_SECRET_KEY=

# Синхронизация с серверами почты (IMAP). Выключено — почта не ходит вообще.
MAIL_SYNC_ENABLED=false
# Как часто делать плановый проход по папкам, секунды (IDLE даёт мгновенный приход,
# это — страховка на случай разорванного соединения).
MAIL_SYNC_INTERVAL_SEC=300
# Нижняя граница истории, дни: старше не забираем. 0 — без ограничения (история идёт
# назад, пока она есть). Письма идут от свежих к старым, поэтому интерфейс наполняется
# с первого прохода, а глубина добирается фоном.
MAIL_BACKFILL_DAYS=0
# Сколько писем истории забирать за один проход. У Gmail лимит на скачивание по IMAP
# (порядка 2.5 ГБ в сутки на аккаунт), поэтому история идёт порциями.
MAIL_BACKFILL_PER_PASS=200
# Потолок трафика, МБ. Считается на аккаунт за проход: бюджет заводится один раз на обход
# всех папок аккаунта, поэтому суточный лимит IMAP расходуется ровно на столько, на сколько
# его тратит сам проход, а не кратно числу папок.
MAIL_PASS_BUDGET_MB=300
# Потолка одновременных IMAP-соединений здесь нет намеренно: настройки не существует — число
# соединений задаёт сам сервис (на каждый аккаунт одно сторожевое в IDLE, одно на проход и одно
# на чистку, пока она идёт — см. mail-sync.service.ts). Переменная, которую никто не читает,
# вводила бы в заблуждение.
# Потолок размера одного письма, МБ. Размер узнаётся из заголовков ДО скачивания тела:
# письмо больше потолка пропускается с причиной в логе, курсор за него не двигается
# и следующая попытка будет по тому же письму.
MAIL_MAX_MESSAGE_MB=64
# Необратимая чистка копий писем на сервере провайдера (раздел «Корзина» почты). По умолчанию
# ВЫКЛЮЧЕНА: пока флаг не выставлен, сервис каждые 5 минут пишет в лог, что ничего не удаляет.
# Включать осознанно и сначала посмотреть, что он собирается удалить:
#   MAIL_PURGE_DRY_RUN=true  — только отчёт: кандидаты отбираются и проверяются, в БД и на
#   сервере не меняется ничего; в лог уходит список с причинами.
MAIL_PURGE_ENABLED=false
MAIL_PURGE_DRY_RUN=false
# Поиск по почте. Полного тела письма в БД нет (там только превью в 2000 символов), поэтому
# текст для поиска лежит отдельной колонкой `MailMessage.searchText`, а письма, сохранённые
# до появления поиска, разбираются заново из .eml в S3 — фоном, порциями. Пока проход
# не закончился, поиск не видит эту часть архива: сколько писем осталось, сказано в ответе
# ручки `/mail/search` полем `pending`.
MAIL_SEARCH_INDEX_ENABLED=true
# Сколько писем разбирать за один проход и как часто проход запускать, секунды. Письма
# читаются из S3, поэтому порция намеренно небольшая (см. src/mail/mail-index.service.ts).
MAIL_SEARCH_INDEX_BATCH=100
MAIL_SEARCH_INDEX_INTERVAL_SEC=60

# ===== Локальная модель (перевод писем через «Перевести») =====
# Модель живёт на домашнем маке (llama.cpp) и приходит сюда тем же reverse-SSH туннелем, что и
# мост pi: на VPS открыт только loopback-порт 18812. Запросы делает сервер, поэтому в сборку
# приложения не вшивается ни адрес, ни ключ. Адрес — тот же порт, что в `run-tunnel.sh`
# на маке («llama.cpp, local LLM for CloudlyRu»): менять вместе с туннелем.
LLM_BASE_URL=http://127.0.0.1:18812
# Панель управления маком (раздел «Mac»): тот же reverse-SSH туннель, loopback VPS (порт 18810).
MAC_STATUS_URL=http://127.0.0.1:18810
# Сервис-токен панели (`X-Mac-Token`): то же значение, что MAC_SERVICE_TOKEN в ~/work/.env на
# маке. Пусто — панель работает без проверки (браузерная панель за nginx basic-auth).
MAC_SERVICE_TOKEN=
# Ключ движка: нужен только если он умеет требовать авторизацию. У llama.cpp обычно пусто.
LLM_API_KEY=
# Идентификатор модели в том виде, в каком его отдаёт движок (`GET /v1/models`).
LLM_MODEL=qwen/qwen3.5-9b
# Окно контекста ОДНОГО слота движка, токены. Обязано совпадать с `-c` в запуске llama.cpp:
# от него выводится потолок входа и размер куска перевода. Превышение движок отвергает.
LLM_CTX=32768
# `reasoning_effort`: none | low | medium | high. Пусто — параметр не отправляется.
# `none` нужен, чтобы модель не потратила весь бюджет ответа на «размышления».
LLM_REASONING=none
# Второй выключатель размышлений — через шаблон чата; у llama.cpp это `enable_thinking`.
LLM_TEMPLATE_KWARGS={"enable_thinking":false}
# Потолок на один ответ целиком, мс: холодная модель загружается, длинное письмо переводится
# несколькими вызовами подряд.
LLM_TIMEOUT_MS=600000

# ===== Фактуры (раздел перенесён из отдельного сервиса iq-factura) =====
# Компания-эмитент: в прежнем сервисе она выбиралась из связки пользователь↔компания,
# теперь владелец один, и её id фиксируется здесь. Пусто — фактурные ручки не работают.
FACTURA_COMPANY_ID=

# Бакет с PDF инвойсов и сканами расходов. Креды и endpoint берутся общие (S3_FILES_*):
# те же ключи Hetzner открывают этот бакет, а объекты в нём адресованы по companyId,
# поэтому перенос данных ключи не меняет.
S3_INVOICES_BUCKET=iq-factura-invoices

# Ключ Gemini: разбор сканов расходов и поданных деклараций, разбор вставленного текста
# в контрагента. Пусто — разбор отключается, остальное работает.
GEMINI_API_KEY=

# VeriFactu: disabled — ничего не делаем; local — пишем записи с хеш-цепочкой и QR, но в AEAT
# не отправляем; submit — ещё и отправляем. В разработке и на копии прод-данных обязан быть
# local или disabled: при submit тестовые фактуры уходят в прод AEAT по реальному NIF.
VERIFACTU_MODE=disabled
VERIFACTU_ENV=sandbox

# 32-байтный ключ (base64) шифрования сертификатов компаний (AES-256-GCM). Тот же, что был
# в iq-factura: иначе уже загруженный сертификат не расшифруется и отправка в AEAT встанет.
VERIFACTU_MASTER_KEY=

# Номер установки в AEAT. Пусто — берётся id компании (историческое поведение сервиса):
# менять его нельзя, иначе AEAT увидит новую установку.
VERIFACTU_INSTALLATION_ID=

