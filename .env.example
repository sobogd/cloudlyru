# ============================================================
# CloudlyRu — конфигурация. Скопируйте на сервер в .env (chmod 600).
# Значения НИКОГДА не коммитим: в репо только этот шаблон.
# ============================================================

NODE_ENV=production
PORT=8305
BASE_URL=https://files.iq-factura.com

# Postgres (создать: createuser cloudly -P && createdb -O cloudly cloudly)
DATABASE_URL=postgresql://cloudly:CHANGE_ME@127.0.0.1:5432/cloudly

# Сессии
SESSION_SECRET=CHANGE_ME_64_hex_chars
SESSION_TTL_DAYS=30
COOKIE_NAME=cl_session

# Первичный админ (создаётся автоматически при первом старте, если User нет)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_initial_password

# Hetzner Object Storage (бакет cloudlyru @ NBG1)
S3_FILES_ACCESS_KEY=
S3_FILES_SECRET_KEY=
S3_FILES_ENDPOINT=https://nbg1.your-objectstorage.com
S3_FILES_REGION=nbg1
S3_FILES_BUCKET=cloudlyru
S3_FILES_FORCE_PATH_STYLE=true

# Загрузки
UPLOAD_CHUNK_MAX_MB=20
# 64 ГиБ: архивы Google Takeout по 50 ГиБ на границе могут слегка превышать 50 ГиБ
# (наблюдали 53.69 ГБ) — при 51200 МБ такие архивы отвергались «file too large».
MAX_FILE_SIZE_MB=65536
TRASH_RETENTION_DAYS=30

# Конвертация медиа (зона «Фото»)
# CONVERT_ENABLED=true включает in-process воркер очереди (ffmpeg/heif-convert/sharp).
CONVERT_ENABLED=true
# Лимит виртуальной памяти на один внешний процесс (ffmpeg и т.п.), МБ.
# ВНИМАНИЕ: это RLIMIT_AS (адресное пространство), а не RSS. libaom-av1 для 4K
# и для 10-битных кадров упирается в него, хотя реальный RSS ~0.6 ГБ:
#   "Failed to initialize encoder: Memory allocation error"
# Для 4K-мастеров нужен запас (см. также KEEP_ORIGINALS и порядок в convertVideo).
CONVERT_MEM_MB=1536
# Хранить оригинал в S3 после успешной конвертации (true — рекомендуется).
# После конвертации оригинал нужен для пересборки мастера: ICC-профиль, gain map,
# MPF/depth и часть MakerNotes восстановить из мастера нельзя.
KEEP_ORIGINALS=true

# (deploy trigger test)

# (deploy trigger test 2)
