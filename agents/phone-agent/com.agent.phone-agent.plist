<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd-агент сервиса телефона (agents/phone-agent/server.py): поиск и чтение страниц
  в настоящем Chrome на телефоне через ADB и Chrome DevTools Protocol.

  Ставится копированием и загрузкой:
    cp agents/phone-agent/com.agent.phone-agent.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.agent.phone-agent.plist

  Python берётся из venv рядом с кодом: сервису нужен `websockets` для протокола отладки
  Chrome (в системном Python его нет). Венв создаётся на маке и в git не хранится:
    python3 -m venv agents/phone-agent/.venv && agents/phone-agent/.venv/bin/pip install websockets

  KeepAlive: сервис вечный; если упадёт (например, на необработанном исключении), агент в
  чате обязан получить его обратно сам, а не молчать до следующего входа в систему.

  Порт 18816 — тот же, что проброшен туннелем (VPS 127.0.0.1:18816 -> мак 18816) и что
  прописан в окружении сервера (`AGENT_URL`). Телефон должен быть подключён к маку по USB
  и разблокирован: без него сервис жив, но каждое задание отвечает отказом.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent.phone-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/sobogd/work/iq-rest/cloudlyru/agents/phone-agent/.venv/bin/python</string>
    <string>/Users/sobogd/work/iq-rest/cloudlyru/agents/phone-agent/server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sobogd/work/iq-rest/cloudlyru/agents/phone-agent</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/phone-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/phone-agent.err.log</string>
</dict>
</plist>
