<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent.android-agent</string>
  <!-- Python системный, а не из venv: агенту нужны только стандартная библиотека и adb,
       сторонних пакетов у него нет вовсе (Playwright остался у сервиса поиска). Ставить
       что-то в системный Python не приходится, поэтому и venv здесь лишний. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/sobogd/work/iq-rest/cloudlyru/agents/android-agent/server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sobogd/work/iq-rest/cloudlyru/agents/android-agent</string>
  <!-- Режим разбора: 1 — в лог пишется то, на что агент смотрел (текст экрана, ответ модели,
       выполненное действие с подписью элемента). По умолчанию 0: в логе мака не должно быть
       содержимого страниц владельца. Включается на время разбора, потом обратно в 0, и каждый
       раз требует перезапуска: launchctl kickstart -k gui/501/com.agent.android-agent -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_DEBUG</key>
    <string>0</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- KeepAlive: сервер вечный и в штатном режиме не выходит, но если упадёт (например, на
       необработанном исключении), агент обязан вернуться сам — иначе в чате останется режим,
       который молча никуда не ходит, до следующего входа владельца на мак. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/android-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/android-agent.err.log</string>
</dict>
</plist>
