<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd-агент моста до харнессов (agents/bridge/server.py): Claude Code и llm-harness.

  Ставится копированием в ~/Library/LaunchAgents и загрузкой:
    cp agents/bridge/com.agent.bridge.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.agent.bridge.plist

  Python — из venv в agents/bridge/.venv: мост пользуется не только стандартной библиотекой —
  адаптер к llm-harness ходит по gRPC (grpcio). venv создаётся install.sh из agents/mac,
  если его ещё нет.

  Порт 18820 слушает только loopback, и на VPS его видит только сервер приложения — через
  reverse-SSH туннель мака (строка -R 127.0.0.1:18820 в cloudlyru/agents/mac/run-tunnel.sh).
  Менять порт нужно вместе с этим скриптом и с BRIDGE_URL в окружении сервера.

  KeepAlive: раздел «Проекты» в приложении без моста не работает вовсе, поэтому упавший
  сервис обязан вернуться сам. ThrottleInterval не даёт ему крутиться в цикле перезапусков,
  если он падает сразу (например, порт занят другим процессом).

  HOME задан явно: launchd не наследует окружение оболочки, а мост ищет сессии Claude Code
  и настройки по ~/.claude — без HOME он стартовал бы как чужой пользователь.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/sobogd/work/cloudlyru/agents/bridge/.venv/bin/python3</string>
    <string>/Users/sobogd/work/cloudlyru/agents/bridge/server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sobogd/work/cloudlyru/agents/bridge</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/sobogd/.nvm/versions/node/v22.23.3/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/sobogd</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/agent-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agent-bridge.err.log</string>
</dict>
</plist>
