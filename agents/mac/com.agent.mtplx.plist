<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd-агент главной локальной модели: Qwen3.8-27B (MTPLX, порт 8000).

  Ставится копированием и загрузкой:
    cp com.agent.mtplx.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.agent.mtplx.plist
  (install.sh в этой папке деплоит всех агентов разом)

  Скрипт — вечный сторож (run-mtplx-serve.sh): проверяет /health каждые
  30 секунд, при падении перезапускает сервер полным явным запуском.
  RunAtLoad поднимает его при входе в систему после перезагрузки мака,
  KeepAlive не даёт самому сторожу исчезнуть.

  Сервер слушает только loopback — снаружи он не смотрит, поэтому ни TLS,
  ни авторизации здесь нет; доступ к нему получает только тот, кто уже
  внутри мака.

  HOME задан явно: launchd не наследует окружение оболочки, а mtplx ищет
  модель (~/.mtplx/models), сессионный кеш (~/.mtplx/session-bank) и
  настройки (~/.mtplx/settings.json) по $HOME.

  Вентилятор: в запуске стоит --fan-mode max (стол, без батареи). Реально
  работает только если установлен thermal-инструмент: mtplx max --install
  (или TG Pro); без него mtplx продолжит работать без управления вентилятором.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent.mtplx</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/sobogd/work/cloudlyru/agents/mac/run-mtplx-serve.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/sobogd</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/mtplx-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mtplx-agent.err.log</string>
</dict>
</plist>
